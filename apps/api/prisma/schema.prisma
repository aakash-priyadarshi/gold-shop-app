generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [vector]
}

model User {
  id                   String                  @id @default(uuid())
  email                String                  @unique
  phone                String?                 @unique
  passwordHash         String
  googleId             String?                 @unique
  role                 UserRole
  status               UserStatus              @default(PENDING_VERIFICATION)
  firstName            String
  lastName             String
  preferredLanguage    String                  @default("en")
  preferredCurrency    CurrencyCode            @default(NPR)
  preferredCountry     String                  @default("US")
  preferredState       String?
  preferredCity        String?
  themeMode            String                  @default("system")
  emailVerified        Boolean                 @default(false)
  emailVerifiedAt      DateTime?
  phoneVerifiedAt      DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  lastLoginAt          DateTime?
  // Multi-shop support
  activeShopId         String?
  // 2FA support
  twoFactorEnabled     Boolean                 @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]
  apiTokens            ApiToken[]
  auditLogs            AuditLog[]
  emailLogs            EmailLog[]
  recoveryOffers       RecoveryOffer[]
  planInquiries        PlanInquiry[]
  notifications        Notification[]
  customerOrders       Order[]                 @relation("CustomerOrders")
  refreshTokens        RefreshToken[]
  reportsAgainst       Report[]                @relation("ReportReported")
  reportsFiled         Report[]                @relation("ReportReporter")
  rfqRequests          RfqRequest[]            @relation("CustomerRfqs")
  shops                Shop[]
  verificationRequests VerificationRequest[]   @relation("UserVerificationRequests")
  purchaseStats        CustomerPurchaseStats[]
  // Design gallery
  designs              Design[]                @relation("DesignCreator")
  designLikes          DesignLike[]
  // Delivery addresses
  deliveryAddresses    CustomerAddress[]
  // CRM notes
  customerNotes        CustomerNote[]          @relation("CustomerNotes")
  authoredNotes        CustomerNote[]          @relation("AuthoredNotes")
  // Chat
  sentMessages         Message[]               @relation("MessageSender")
  buyerConversations   Conversation[]          @relation("BuyerConversations")
  // Support Tickets
  supportTickets       SupportTicket[]         @relation("UserTickets")
  assignedTickets      SupportTicket[]         @relation("AssignedTickets")
  ticketMessages       TicketMessage[]         @relation("TicketMessageSender")
  // POS / Wishlist
  wishlistItems        WishlistItem[]
  // AI Credits (fractional — product descriptions cost 0.25)
  aiCreditsBalance     Decimal                 @default(0) @db.Decimal(12, 2)
  aiCreditsGrantedAt   DateTime?
  aiCreditLedger       AiCreditLedger[]
  // Enterprise staff
  staffAccounts        StaffAccount[]
  // Desktop app sessions
  desktopSessions      DesktopSession[]
  // Web app sessions
  webSessions          WebSession[]
  // POS Shifts & POS Actions
  shiftsOpened         PosShift[]              @relation("ShiftOpenedBy")
  shiftsClosed         PosShift[]              @relation("ShiftClosedBy")
  posInvoiceCashiers   Invoice[]               @relation("InvoicePosCashier")
  posReturnCashiers    PosReturn[]             @relation("PosReturnCashier")

  // Custom Profile Enrivhment fields
  dateOfBirth DateTime?
  gender      String? // e.g. "MALE", "FEMALE", "OTHER"

  // Survey responses
  surveyResponses SurveyResponse[]

  // Google People API enriched data
  googleBirthday   String? // "YYYY-MM-DD" or partial
  googleGender     String? // "male" | "female" | "unspecified"
  googlePhoneRaw   String?
  googleAddressRaw Json?
  googleLocale     String? // e.g. "en-IN"
  googlePicture    String? // profile photo URL

  // 6-digit PIN fast login (after session timeout)
  pinHash        String? // bcrypt hash
  pinSetAt       DateTime?
  pinFailedCount Int       @default(0)
  pinLockedUntil DateTime? // locked for 15min after 5 fails

  marketingUnsubscribedAt DateTime?

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([activeShopId])
}

// Customer delivery addresses
model CustomerAddress {
  id           String   @id @default(uuid())
  userId       String
  label        String   @default("Home") // Home, Work, Other
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String   @default("IN")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
}

// Track customer purchase statistics by currency
model CustomerPurchaseStats {
  id          String       @id @default(uuid())
  customerId  String
  currency    CurrencyCode
  orderCount  Int          @default(0)
  totalSpent  Float        @default(0)
  lastOrderAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, currency])
  @@index([customerId])
  @@index([currency])
}

// CRM: Notes about customers added by shop staff
model CustomerNote {
  id         String   @id @default(uuid())
  customerId String // User ID of the customer
  shopId     String? // Which shop's staff added this note (null for admin notes)
  authorId   String // User ID of the shop staff or admin who wrote it
  note       String
  category   String   @default("GENERAL") // GENERAL, PREFERENCE, FOLLOW_UP, COMPLAINT, VIP
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer User  @relation("CustomerNotes", fields: [customerId], references: [id], onDelete: Cascade)
  shop     Shop? @relation("ShopCustomerNotes", fields: [shopId], references: [id], onDelete: Cascade)
  author   User  @relation("AuthoredNotes", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([shopId])
  @@index([customerId, shopId])
}

/// Persistent translation cache (source of truth).
/// Tier 3 of the read pipeline: Memory → Redis → Translation (DB) → Gemini.
/// Once Gemini translates a string for a locale, it is upserted here forever
/// so every other user (and every redeploy / Redis flush) gets it for free.
model Translation {
  id          String   @id @default(cuid())
  /// 2-letter locale code (e.g. "hi", "fr", "ar"). Always lowercase.
  locale      String   @db.VarChar(8)
  /// sha256(sourceText).hex sliced to 32 chars — collision-resistant key.
  sourceHash  String   @db.VarChar(32)
  /// Original English source text (kept for debugging / re-translation).
  sourceText  String   @db.Text
  /// Translated text in the target locale.
  translation String   @db.Text
  /// Model that produced the translation (for future re-translations / audits).
  model       String   @default("gemini-2.0-flash") @db.VarChar(64)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([locale, sourceHash])
  @@index([locale])
  @@index([createdAt])
}

/// Persistent cache of fully-assembled HTML translations.
/// Same tiering as Translation but keyed by content hash of the entire HTML
/// document so unchanged pages are served as one DB row hit.
model HtmlTranslation {
  id          String   @id @default(cuid())
  locale      String   @db.VarChar(8)
  /// sha256(html).hex sliced to 40 chars.
  contentHash String   @db.VarChar(40)
  html        String   @db.Text
  model       String   @default("gemini-2.0-flash") @db.VarChar(64)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([locale, contentHash])
  @@index([locale])
}

model EmailLog {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  direction   String
  fromAddress String
  toAddress   String
  subject     String
  body        String   @db.Text
  userId      String?
  adminId     String?
  threadId    String?
  messageId   String?
  provider    String?
  templateKey String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([direction])
  @@index([templateKey])
  @@index([userId])
}

model EmailTemplate {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  key         String   @unique
  name        String
  description String?
  audience    String
  trigger     String?
  subject     String   @db.Text
  html        String   @db.Text
  text        String?  @db.Text
  senderName  String
  senderEmail String
  replyTo     String?
  variables   String[] @default([])
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  versions EmailTemplateVersion[]

  @@index([audience])
  @@index([isActive])
}

model EmailTemplateVersion {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  templateId  String
  version     Int
  subject     String   @db.Text
  html        String   @db.Text
  text        String?  @db.Text
  senderName  String
  senderEmail String
  replyTo     String?
  variables   String[] @default([])
  createdBy   String?
  createdAt   DateTime @default(now())

  template EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model ApiToken {
  id                 String    @id @default(uuid())
  userId             String
  /// Set only for the read-only seller smoke token. Binding the token to a
  /// single shop prevents a later active-shop switch from widening its scope.
  shopId             String?
  name               String
  tokenHash          String    @unique
  tokenPrefix        String
  scopes             String[]  @default([])
  expiresAt          DateTime
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  encryptedToken     String?
  tokenViewableUntil DateTime?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop               Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shopId])
  @@index([tokenHash])
  @@index([tokenPrefix])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Shop {
  id                        String                @id @default(uuid())
  userId                    String
  shopName                  String
  shopNameNe                String?
  shopNameHi                String?
  slug                      String?               @unique
  description               String?
  descriptionNe             String?
  descriptionHi             String?
  about                     String? // Moderated about section (no contacts allowed)
  profileImage              String? // Shop profile picture URL
  coverImage                String? // Shop cover/banner image URL
  country                   String                @default("NP")
  // Billing/display currency for this shop. Backfilled from `country` on
  // migration; falls back to NPR (home market) for unmapped countries.
  currency                  CurrencyCode          @default(NPR)
  state                     String?
  city                      String
  address                   String
  pincode                   String?
  latitude                  Float?
  longitude                 Float?
  contactPhone              String
  contactEmail              String?
  whatsappNumber            String?
  isVerified                Boolean               @default(false)
  verificationDocuments     Json?
  bisLicenseNumber          String?
  panNumber                 String?
  vatNumber                 String?
  vatRegistrationStatus     VatRegistrationStatus @default(NOT_REGISTERED)
  vatRegistrationVerifiedAt DateTime?
  supportedJewelleryTypes   String[]
  supportedMethods          String[]
  supportedMaterials        String[]
  supportedGemstones        String[]
  supportedFinishes         String[]
  supportedAlloys           String[] // e.g. ["GOLD_18K", "GOLD_14K", "STERLING_SILVER_925"]
  supportedBaseMetals       String[] // e.g. ["BRASS", "COPPER", "STAINLESS_STEEL_316L"]
  supportedPlatingTypes     String[] // e.g. ["GOLD_PLATING", "RHODIUM_PLATING", "PVD_COATING"]
  minOrderValueNpr          Float                 @default(0)
  maxOrderValueNpr          Float?
  maxWeightGrams            Float?
  acceptsComplexOrders      Boolean               @default(true)
  codEnabled                Boolean               @default(false)
  codMaxValueNpr            Float?
  bankAccountDetails        Json?
  makingChargePercent       Float                 @default(10)
  /// AUTO | DISABLED | WEIGHT_PERCENT | METAL_VALUE_PERCENT — customer billing wastage
  billingWastageMode        String                @default("AUTO")
  /// When set, overrides country default wastage %. Null = use market default.
  billingWastagePercent     Float?
  /// Factory floor UI. Off = Supply Chain karigar book. On + workshopManufacturing = Workshop nav.
  workshopMode              Boolean               @default(false)
  /// Ordered KarigarStage keys for Floor queues. Null = CASTING → … → QC.
  workshopDepartments       Json?
  nickelCompliantFlag       Boolean               @default(false)
  isActive                  Boolean               @default(true)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  holdAt                    DateTime?
  holdReason                String?
  isOnHold                  Boolean               @default(false)
  lastComplianceCheckAt     DateTime?

  // Seller tier & performance fields
  sellerTier       SellerTier @default(STANDARD)
  tierUnlockedAt   DateTime?
  tierLockedReason String?
  eliteFastTracked Boolean    @default(false)
  makingChargeCap  Float      @default(15) // Dynamic cap per tier
  suspendedAt      DateTime?
  suspensionCount  Int        @default(0)
  disputeCount     Int        @default(0)
  firstSaleAt      DateTime?

  commissionLedgers            CommissionLedger[]
  ledgerAccounts               LedgerAccount[]
  journalEntries               JournalEntry[]
  inventoryItems               InventoryItem[]
  stockMovements               InventoryStockMovement[]
  priceHistory                 InventoryPriceHistory[]
  storageLocations             StorageLocation[]
  orders                       Order[]
  rfqOffers                    RfqOffer[]
  shopQuotes                   ShopQuote[]
  walkInCustomers              WalkInCustomer[]
  user                         User                      @relation(fields: [userId], references: [id])
  finishPricing                ShopFinishPricing[]
  gemstoneRates                ShopGemstoneRate[]
  metalRates                   ShopMetalRate[]
  priceOverrides               ShopPriceOverride[]
  ratings                      ShopRating[]
  verificationRequests         VerificationRequest[]     @relation("ShopVerificationRequests")
  performance                  SellerPerformance?
  badges                       SellerBadge[]
  invoices                     Invoice[]
  invoiceSettings              InvoiceSettings?
  customerNotes                CustomerNote[]            @relation("ShopCustomerNotes")
  conversations                Conversation[]            @relation("ShopConversations")
  catalogues                   Catalogue[]
  walkInRfqs                   RfqRequest[]              @relation("ShopWalkInRfqs")
  showroomSessions             ShowroomSession[]
  posSessions                  PosSession[]
  stockReservations            StockReservation[]
  subscriptions                SellerSubscription[]
  recoveryOffers               RecoveryOffer[]
  offerCampaignRedemptions     OfferCampaignRedemption[]
  planInquiries                PlanInquiry[]
  planQuotes                   PlanQuote[]
  platformReviews              PlatformReview[]
  referralsMade                Referral[]                @relation("ShopReferralsMade")
  referralsReceived            Referral[]                @relation("ShopReferralsReceived")
  referralCode                 String?                   @unique
  referralCommissionsEarned    ReferralCommission[]      @relation("ReferralCommissionsEarned")
  referralCommissionsGenerated ReferralCommission[]      @relation("ReferralCommissionsGenerated")
  referralPayoutProfile        ReferralPayoutProfile?
  referralPayoutRequests       ReferralPayoutRequest[]
  // Enterprise features
  branches                     ShopBranch[]
  staffAccounts                StaffAccount[]
  apiKeys                      ShopApiKey[]
  sellerAiActions              SellerAiAction[]
  apiTokens                    ApiToken[]
  webhookSubscriptions         WebhookSubscription[]
  whiteLabelConfig             WhiteLabelConfig?
  scheduledReports             ScheduledReport[]
  bulkImportJobs               BulkImportJob[]
  demandForecasts              DemandForecast[]
  repricingRules               RepricingRule[]
  stockAudits                  StockAudit[]

  /// Manager PIN (bcrypt) — gates discounts, voids, stock adjustments, audit complete
  managerPinHash              String?
  managerPinSetAt             DateTime?
  /// Discount amount above this requires manager PIN (shop currency units)
  managerPinDiscountThreshold Float?    @default(0)

  // Mobile shopkeeper tools (offline-first capable)
  repairJobs                  RepairJob[]
  savingsMembers              SavingsMember[]
  chitGroups                  ChitGroup[]
  goldLoans                   GoldLoan[]
  karigarWorkshops            KarigarWorkshop[]
  karigarJobs                 KarigarJob[]
  karigarVaultReserves        KarigarVaultReserve[]
  karigarMetalMovements       KarigarMetalMovement[]
  karigarJobStages            KarigarJobStage[]
  karigarCastingTrees         KarigarCastingTree[]
  karigarFinancialEntries     KarigarFinancialEntry[]
  karigarFinancialAllocations KarigarFinancialAllocation[]

  // POS Registers & Shifts & Returns
  posRegisters PosRegister[]
  posShifts    PosShift[]
  posReturns   PosReturn[]

  // AI Credit Auto-Recharge
  autoRechargeEnabled   Boolean @default(false)
  autoRechargeThreshold Int     @default(5) // trigger when balance drops below this
  autoRechargePack      Int     @default(50) // credits to buy per auto-recharge

  @@index([userId])
  @@index([country, city])
  @@index([isActive, isVerified])
  @@index([sellerTier])
}

model ShopMetalRate {
  id             String   @id @default(uuid())
  shopId         String
  metalType      String
  ratePerGramNpr Float
  lastUpdatedAt  DateTime @default(now())
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, metalType])
  @@index([shopId])
}

model ShopFinishPricing {
  id         String @id @default(uuid())
  shopId     String
  finishType String
  tier       String
  priceNpr   Float
  shop       Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, finishType, tier])
  @@index([shopId])
}

model ShopGemstoneRate {
  id            String   @id @default(uuid())
  shopId        String
  stoneType     String // e.g. DIAMOND, RUBY, EMERALD, SAPPHIRE, etc.
  origin        String   @default("NATURAL") // NATURAL or LAB_GROWN
  sizeCategory  String // e.g. "0.1-0.25", "0.25-0.5", "0.5-1", "1-2" (carat ranges)
  qualityTier   String   @default("MEDIUM") // LOW, MEDIUM, HIGH, PREMIUM
  pricePerStone Float // NPR per stone
  lastUpdatedAt DateTime @default(now())
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, stoneType, origin, sizeCategory, qualityTier])
  @@index([shopId])
}

model Material {
  id               String           @id @default(uuid())
  code             String           @unique
  category         MaterialCategory
  nameEn           String
  nameNe           String?
  nameHi           String?
  descriptionEn    String?
  descriptionNe    String?
  descriptionHi    String?
  purity           Float?
  allowedMethods   String[]
  complianceFlags  String[]
  baseUnit         String           @default("gram")
  marketRateNpr    Float?
  lastMarketUpdate DateTime?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([category])
  @@index([code])
}

model StorageLocation {
  id        String              @id @default(uuid())
  shopId    String
  name      String
  code      String?
  parentId  String?
  kind      StorageLocationKind @default(AREA)
  sortOrder Int                 @default(0)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  shop     Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  parent   StorageLocation?  @relation("StorageLocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children StorageLocation[] @relation("StorageLocationTree")
  items    InventoryItem[]

  @@index([shopId, isActive])
  @@index([shopId, parentId])
  @@index([parentId])
}

model InventoryItem {
  id                String                   @id @default(uuid())
  shopId            String
  sku               String                   @unique
  jewelleryType     JewelleryType
  nameEn            String
  nameNe            String?
  nameHi            String?
  descriptionEn     String?
  descriptionNe     String?
  descriptionHi     String?
  buildMethod       String
  composition       Json
  /// Metal-only weight. Gemstone carats are converted separately for gross weight.
  totalWeightGrams  Float
  /// Read-only derived weight: metal grams + gemstone carats × 0.2g.
  grossWeightGrams  Float                    @default(0)
  dimensions        Json?
  gemstones         Json?
  metalValueNpr     Float
  makingChargeNpr   Float
  /// Customer billing wastage % (jarti) default for this piece — applied on invoice
  wastagePercent    Float                    @default(0)
  gemstoneValueNpr  Float                    @default(0)
  taxNpr            Float                    @default(0)
  totalPriceNpr     Float
  /// Set pricing: PERCENT or FIXED off sum of component prices
  setDiscountType   String?
  setDiscountValue  Float?
  images            String[]
  videos            String[]
  certificateUrl    String?
  hallmarkNumber    String?
  /// Physical RFID / EPC value assigned to this individual piece.
  /// QR labels use the immutable inventory id, so an RFID label can be
  /// replaced without invalidating existing QR tags.
  rfidCode          String?                  @unique
  hallmarkDate      DateTime?
  /// UK assay office (London / Birmingham / Sheffield / Edinburgh)
  assayOffice       AssayOffice?
  purityCertUrl     String?
  labels            String[]
  locationId        String?
  status            InventoryStatus          @default(AVAILABLE)
  stockQuantity     Int                      @default(1)
  hasSizes          Boolean                  @default(false)
  visibility        InventoryVisibility      @default(PUBLIC)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  shop              Shop                     @relation(fields: [shopId], references: [id])
  location          StorageLocation?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  variants          ProductVariant[]
  catalogueItems    CatalogueItem[]
  wishlistItems     WishlistItem[]
  posSessionItems   PosSessionItem[]
  stockReservations StockReservation[]
  stockMovements    InventoryStockMovement[]
  setComponents     InventorySetComponent[]  @relation("SetParent")
  memberOfSet       InventorySetComponent?   @relation("SetComponent")
  priceHistory      InventoryPriceHistory[]
  stockAuditScans   StockAuditScan[]
  sourceKarigarJob  KarigarJob?

  @@index([shopId, status])
  @@index([jewelleryType])
  @@index([buildMethod])
  @@index([visibility])
  @@index([locationId])
}

/// Links a sellable SET InventoryItem to its component pieces.
model InventorySetComponent {
  id              String   @id @default(uuid())
  setItemId       String
  componentItemId String   @unique
  role            String? // EARRING, MAANG_TIKKA, NECKLACE, NATHUNI, etc.
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  setItem       InventoryItem @relation("SetParent", fields: [setItemId], references: [id], onDelete: Cascade)
  componentItem InventoryItem @relation("SetComponent", fields: [componentItemId], references: [id], onDelete: Cascade)

  @@index([setItemId])
}

/// Immutable stock ledger for sales, voids, and adjustments.
model InventoryStockMovement {
  id              String   @id @default(uuid())
  shopId          String
  inventoryItemId String
  variantId       String?
  delta           Int // negative = sale/outbound, positive = restore/inbound
  reason          String // POS_SALE, INVOICE_VOID_RESTORE, ADJUSTMENT, ORDER_SALE
  referenceType   String? // PosSession, Invoice, Order
  referenceId     String?
  notes           String?
  createdAt       DateTime @default(now())

  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([inventoryItemId, createdAt])
  @@index([referenceType, referenceId])
}

/// RFID / barcode stock count session (keyboard-wedge scanners supported)
model StockAudit {
  id              String    @id @default(uuid())
  shopId          String
  status          String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | CANCELLED
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  startedByUserId String?
  notes           String?
  /// { expectedCount, scannedUnique, matchedCount, missingCount, unmatchedScans }
  summary         Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop  Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  scans StockAuditScan[]

  @@index([shopId, status])
  @@index([shopId, startedAt])
}

model StockAuditScan {
  id              String   @id @default(uuid())
  auditId         String
  code            String
  inventoryItemId String?
  matched         Boolean  @default(false)
  scannedAt       DateTime @default(now())

  audit         StockAudit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([auditId, scannedAt])
  @@index([auditId, inventoryItemId])
  @@index([code])
}

/// Audit log when catalog prices are repriced from metal rates
model InventoryPriceHistory {
  id              String   @id @default(uuid())
  shopId          String
  inventoryItemId String
  oldValues       Json // { metalValueNpr, makingChargeNpr, gemstoneValueNpr, taxNpr, totalPriceNpr }
  newValues       Json
  reason          String?
  rateSnapshot    Json? // rates used for the reprice
  userId          String?
  createdAt       DateTime @default(now())

  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

