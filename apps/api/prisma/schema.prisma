  @@index([rfqId])
  @@index([shopId])
  @@index([status])
}

// Walk-in customer model - for customers who visit the shop in person
// Scoped uniquely to the creating shop so different shops can have customers with the same phone
model WalkInCustomer {
  id               String   @id @default(uuid())
  phone            String // Phone identifier scoped to shop
  phoneCountryCode String
  name             String
  email            String?
  address          String
  city             String
  country          String
  createdByShopId  String // Shop that owns this walk-in customer record
  notes            String? // Any notes about the customer
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdByShop Shop         @relation(fields: [createdByShopId], references: [id])
  shopQuotes    ShopQuote[]
  invoices      Invoice[]
  karigarJobs   KarigarJob[]

  @@unique([createdByShopId, phone])
  @@index([phone])
  @@index([createdByShopId])
}

// Shop Quote model - for walk-in customer orders
// Separate from RfqRequest for cleaner workflow
model ShopQuote {
  id               String @id @default(uuid())
  quoteNumber      String @unique // SQ-XXXXXX
  shopId           String
  walkInCustomerId String

  // Jewellery details (same as RFQ)
  jewelleryType       JewelleryType
  buildMethod         BuildMethod
  composition         Json
  targetTotalWeightG  Float?
  targetGoldWeightG   Float?
  specialInstructions String?
  referenceImages     String[]

  // Pricing (calculated by shopkeeper)
  metalCostNpr      Float?
  makingChargeNpr   Float?
  gemstoneCostNpr   Float  @default(0)
  finishCostNpr     Float  @default(0)
  taxNpr            Float  @default(0)
  totalPriceNpr     Float?
  goldPriceSnapshot Float? // Gold rate at time of quote
  estimatedDays     Int?
  /// Billing wastage % set when marking READY (built). Nullable until then.
  wastagePercent    Float?

  // Status: QUOTED → CONFIRMED → IN_PROGRESS → READY → COMPLETED / CANCELLED
  status       ShopQuoteStatus @default(QUOTED)
  confirmedAt  DateTime?
  startedAt    DateTime?
  readyAt      DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  // Invoice
  invoiceNumber String?   @unique // Generated when quote is invoiced
  invoicedAt    DateTime? // When converted to invoice

  // Tracking (guest + registered customer)
  trackingToken        String? @unique // UUID for public guest tracking URL
  trackingEmailSent    Boolean @default(false)
  trackingSmsSent      Boolean @default(false)
  registeredCustomerId String? // Linked to User account if customer is registered

  // Payment (always at shop)
  advancePaidNpr Float              @default(0)
  balanceDueNpr  Float?
  paidInFullAt   DateTime?
  payments       ShopQuotePayment[]

  // Metadata
  shopNotes String? // Internal notes for shopkeeper
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop           Shop           @relation(fields: [shopId], references: [id])
  walkInCustomer WalkInCustomer @relation(fields: [walkInCustomerId], references: [id])
  karigarJobs    KarigarJob[]

  @@index([shopId])
  @@index([walkInCustomerId])
  @@index([status])
  @@index([quoteNumber])
  @@index([trackingToken])
  @@index([registeredCustomerId])
}

// Immutable quote-payment history. Quote balances are maintained as a
// denormalized summary for fast list rendering, while this ledger is the
// auditable source used when carrying advances into the final invoice.
model ShopQuotePayment {
  id             String   @id @default(uuid())
  shopQuoteId    String
  amount         Float
  method         String   @default("UNSPECIFIED")
  reference      String?
  notes          String?
  idempotencyKey String   @unique
  receivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  shopQuote ShopQuote @relation(fields: [shopQuoteId], references: [id], onDelete: Cascade)

  @@index([shopQuoteId, receivedAt])
}

enum ShopQuoteStatus {
  QUOTED // Initial quote created
  CONFIRMED // Customer agreed, work can start
  IN_PROGRESS // Manufacturing in progress
  READY // Ready for pickup
  COMPLETED // Delivered and fully paid
  CANCELLED // Cancelled by customer or shop
}

