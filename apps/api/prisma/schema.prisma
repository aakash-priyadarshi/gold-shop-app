model Invoice {
  id                   String  @id @default(uuid())
  invoiceNumber        String  @unique
  shopId               String
  orderId              String?
  shopQuoteId          String?
  walkInCustomerId     String? // walk-in CRM link (via quote/POS/manual)
  // Registered customer link for counter/POS invoices. This is deliberately a
  // scalar: marketplace User ownership is optional and historic invoices must
  // remain valid if a customer account is removed.
  registeredCustomerId String?

  // Public bill verification token for QR on printed invoices
  verificationToken String @unique @default(dbgenerated("(gen_random_uuid())::text"))

  // Idempotency key for offline-replayed POS sales (client-generated UUID).
  // A replayed sale with the same key returns the existing invoice instead of
  // creating a duplicate. NULL for non-POS / online back-office invoices.
  posClientId String? @unique

  // Customer details (denormalized for PDF generation)
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerAddress String?
  invoiceTitle    String                @default("INVOICE")
  supplierName    String?
  supplierAddress String?
  supplierPhone   String?
  supplierTaxId   String?
  sellerVatStatus VatRegistrationStatus @default(NOT_REGISTERED)

  // Financial
  subtotal       Float        @default(0)
  taxableAmount  Float        @default(0)
  taxAmount      Float        @default(0)
  taxRate        Float        @default(0)
  taxLabel       String?
  discountAmount Float        @default(0)
  totalAmount    Float        @default(0)
  paidAmount     Float        @default(0)
  balanceDue     Float        @default(0)
  currency       CurrencyCode @default(NPR)

  // Line items as JSON array
  // Each: { label, category, quantity, unitPrice, amount, details? }
  lineItems Json @default("[]")

  // Status
  status        String @default("DRAFT") // DRAFT, ISSUED, PAID, PARTIALLY_PAID, OVERDUE, VOID, CANCELLED
  paymentStatus String @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID

  // Dates
  issuedAt DateTime?
  dueDate  DateTime?
  paidAt   DateTime?
  voidedAt DateTime?

  notes String?
  terms String?

  // POS payment tracking (structured, replaces notes-string hacks)
  paymentMethod    String? // CASH, CARD, UPI, ESEWA, KHALTI, BANK_TRANSFER
  makingChargeRate Float? // percentage e.g. 8.0
  makingChargesAmt Float? // flat calculated amount

  // ── Tax filing fields (Sprint 1) ────────────────────────────────
  isTaxExempt       Boolean   @default(false)
  taxExemptReason   String? // EXPORT, COMPOSITE, REVERSE_CHARGE, THRESHOLD, INVESTMENT_GOLD, OTHER
  customerType      String    @default("B2C") // B2C | B2B
  customerTaxId     String? // GSTIN / TRN / VAT / PAN
  invoiceCountry    String? // ISO-2: NP, IN, AE, GB, DE, US, ...
  placeOfSupply     String? // For India inter-state IGST detection (state code/name)
  hsnCode           String? // HS / HSN classification (jewellery default 7113)
  taxBreakdown      Json? // { igst, cgst, sgst, vat, makingTax, metalTax, ... }
  taxSource         String?
  taxExemptEvidence String?
  supplyDate        DateTime?
  serialSequence    Int?

  // POS multi-counter origin tracking
  posSessionId     String?
  posRegisterId    String?
  posShiftId       String?
  posCashierUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop           Shop             @relation(fields: [shopId], references: [id])
  walkInCustomer WalkInCustomer?  @relation(fields: [walkInCustomerId], references: [id])
  posSession     PosSession?      @relation(fields: [posSessionId], references: [id], onDelete: SetNull)
  posRegister    PosRegister?     @relation(fields: [posRegisterId], references: [id], onDelete: SetNull)
  posShift       PosShift?        @relation(fields: [posShiftId], references: [id], onDelete: SetNull)
  posCashierUser User?            @relation("InvoicePosCashier", fields: [posCashierUserId], references: [id], onDelete: SetNull)
  payments       InvoicePayment[]
  returns        PosReturn[]

  @@index([shopId])
  @@index([orderId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([shopId, issuedAt])
  @@index([invoiceCountry])
  @@index([walkInCustomerId])
  @@index([registeredCustomerId])
  @@index([posRegisterId])
  @@index([posShiftId])
}

enum InvoicePaymentStatus {
  PENDING
  CONFIRMED
  RECEIVED
  FAILED
  CANCELLED
  REFUNDED
  VOIDED
  REVERSED
}

model InvoicePayment {
  id                    String               @id @default(uuid())
  invoiceId             String
  amount                Decimal              @db.Decimal(18, 2)
  currency              CurrencyCode
  canonicalAmountNpr    Decimal?             @db.Decimal(24, 4)
  fxRate                Decimal?             @db.Decimal(24, 10)
  fxSource              String?
  fxQuotedAt            DateTime?
  method                String
  provider              String?
  providerTransactionId String?
  merchantReference     String?
  terminalReference     String?
  bankReference         String?
  confirmedByUserId     String?
  verifiedAt            DateTime?
  verificationMode      String?
  metadata              Json?
  reference             String?
  idempotencyKey        String               @unique
  status                InvoicePaymentStatus @default(RECEIVED)
  notes                 String?
  receivedAt            DateTime             @default(now())
  voidedAt              DateTime?
  voidReason            String?
  reversalOfId          String?
  posReturnId           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  invoice    Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  posReturn  PosReturn?       @relation("PosReturnRefundPayments", fields: [posReturnId], references: [id], onDelete: Restrict)
  reversalOf InvoicePayment?  @relation("InvoicePaymentReversal", fields: [reversalOfId], references: [id])
  reversedBy InvoicePayment[] @relation("InvoicePaymentReversal")

  @@index([invoiceId, receivedAt])
  @@index([status])
  @@index([posReturnId])
  @@index([reversalOfId])
}

model InvoiceSequence {
  id           String       @id @default(uuid())
  shopId       String
  marketRegion MarketRegion
  lastNumber   Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([shopId, marketRegion])
}

// Tax export / share audit log (GDPR + CA collaboration)
model TaxExportLog {
  id             String    @id @default(uuid())
  shopId         String
  exportType     String // GSTR1, GSTR3B, HSN, NEPAL_VAT, UAE_VAT201, UK_MTD, EU_OSS, US_STATE, TALLY_XML, CA_SHARE
  country        String
  period         String // e.g. "2026-02" or "2026-Q1"
  format         String // CSV, JSON, XML, PDF, LINK
  requestedBy    String? // userId
  ipHash         String? // hashed IP, no PII
  shareToken     String?   @unique
  shareExpiresAt DateTime?
  rowCount       Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([shopId, createdAt])
  @@index([shareToken])
}

model InvoiceSettings {
  id     String @id @default(uuid())
  shopId String @unique

  // Branding
  shopNameOnBill String? // Custom name to print on invoice (overrides shop.shopName)
  shopLogoUrl    String? // Logo/icon URL for the bill
  tagline        String? // e.g. "Trusted since 1990"

  // Contact & legal
  shopAddress   String? // Address to show on bill
  shopPhone     String? // Phone to show on bill
  shopEmail     String? // Email to show on bill
  gstin         String? // GST / VAT / PAN number
  licenseNumber String? // BIS / Hallmark license
  footerNote    String? // Custom footer text (e.g. "Thank you for your business")
  termsText     String? // Default terms & conditions

  // Per-field position: each field can be TOP or BOTTOM independently
  shopNamePosition String @default("TOP")
  logoPosition     String @default("TOP")
  taglinePosition  String @default("TOP")
  addressPosition  String @default("TOP")
  phonePosition    String @default("TOP")
  emailPosition    String @default("TOP")
  gstinPosition    String @default("TOP")
  licensePosition  String @default("TOP")
  footerPosition   String @default("BOTTOM")
  termsPosition    String @default("BOTTOM")

  // Printable layout (classic | royal | compact | ornate | minimal)
  billTemplateId String @default("classic")

  // Visibility toggles
  showLogo    Boolean @default(true)
  showAddress Boolean @default(true)
  showPhone   Boolean @default(true)
  showEmail   Boolean @default(false)
  showGstin   Boolean @default(true)
  showLicense Boolean @default(false)
  showFooter  Boolean @default(true)
  showTerms   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════
// MARKETPLACE INTELLIGENCE & AI DATA CAPTURE
// ═══════════════════════════════════════════

// Captures data from every RFQ→Offer→Order cycle for AI training
model RfqOrderInsight {
  id                String  @id @default(uuid())
  rfqId             String
  rfqJewelleryType  String
  rfqBuildMethod    String
  rfqComposition    Json
  rfqBudgetMin      Float?
  rfqBudgetMax      Float?
  rfqWeightCategory String?
  rfqSpecialNotes   String?
  rfqMarketRegion   String?

  // Offer aggregates
  totalOffers        Int    @default(0)
  avgOfferPrice      Float?
  minOfferPrice      Float?
  maxOfferPrice      Float?
  avgMakingChargePct Float?
  avgEstimatedDays   Int?

  // Outcome
  selectedOfferId String?
  selectedShopId  String?
  selectedPrice   Float?
  orderId         String?
  orderCompleted  Boolean @default(false)
  orderRating     Int?

  // Loss analysis
  lossReasons Json? // [{ offerId, reason, category }]

  // Timing metrics
  rfqCreatedAt     DateTime
  firstOfferAt     DateTime?
  offerSelectedAt  DateTime?
  orderCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rfqJewelleryType])
  @@index([rfqBuildMethod])
  @@index([selectedShopId])
  @@index([orderCompleted])
  @@index([rfqCreatedAt])
  @@index([rfqMarketRegion])
}

// Tracks AI phase milestones and admin alerts
model AiPhaseMilestone {
  id              String    @id @default(uuid())
  phase           Int // 1, 2, 3
  milestoneName   String // e.g. "PHASE_1_LAUNCH", "100_ORDERS", "500_ORDERS"
  description     String? // Human-readable description of what this enables
  thresholdValue  Int // 0, 100, 200, 500
  currentValue    Int       @default(0)
  isReached       Boolean   @default(false)
  reachedAt       DateTime?
  adminNotifiedAt DateTime?
  actionItems     Json? // [{ action, status, completedAt }]
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([phase, milestoneName])
  @@index([isReached])
  @@index([phase])
}

// Quote anomaly detection results
model QuoteAnomaly {
  id            String    @id @default(uuid())
  offerId       String
  shopId        String
  rfqId         String
  anomalyType   String // PRICE_TOO_HIGH, PRICE_TOO_LOW, MAKING_CHARGE_SPIKE, DELIVERY_OUTLIER
  severity      String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  expectedValue Float // What the average/median was
  actualValue   Float // What this offer had
  deviationPct  Float // How far off from expected
  isReviewed    Boolean   @default(false)
  reviewedAt    DateTime?
  reviewedBy    String?
  reviewNote    String?
  createdAt     DateTime  @default(now())

  @@index([shopId])
  @@index([anomalyType])
  @@index([isReviewed])
  @@index([severity])
  @@index([createdAt])
}

// ═══════════════════════════════════════════
// IN-APP CHAT SYSTEM (Anti-Circumvention)
// ═══════════════════════════════════════════

model Conversation {
  id        String             @id @default(uuid())
  orderId   String?            @unique
  rfqId     String?
  buyerId   String
  shopId    String
  status    ConversationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  messages Message[]
  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  shop     Shop      @relation("ShopConversations", fields: [shopId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])

  @@index([buyerId])
  @@index([shopId])
  @@index([orderId])
  @@index([rfqId])
  @@index([status])
}

model Message {
  id                String                      @id @default(uuid())
  conversationId    String
  senderId          String
  senderRole        String // CUSTOMER, SHOPKEEPER, SUPPORT, ADMIN
  content           String
  maskedContent     String? // Content after masking PII
  hasViolation      Boolean                     @default(false)
  violationType     String? // PHONE, EMAIL, WHATSAPP, TELEGRAM, INSTAGRAM, CONTACT_PHRASE
  attachmentUrl     String? // R2 image/file URL
  attachmentType    String? // image, document
  messageType       MessageType                 @default(TEXT)
  payload           Json? // Structured payload for PRODUCT_CARD, CATALOGUE_LINK, etc.
  isSystemGenerated Boolean                     @default(false) // System-generated messages bypass PII scanning
  isRead            Boolean                     @default(false)
  readAt            DateTime?
  isSystem          Boolean                     @default(false) // System-generated messages (warnings, etc.)
  isBlocked         Boolean                     @default(false) // Blocked by moderation — not delivered to recipient
  isFalsePositive   Boolean                     @default(false) // Admin manually confirmed this was NOT a violation
  embedding         Unsupported("vector(768)")? // Embedded content for similarity search
  createdAt         DateTime                    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([conversationId, createdAt])
}

// ═══════════════════════════════════════════
// RING / JEWELLERY SIZE CONFIG (Per-Market)
// ═══════════════════════════════════════════

model SizeChart {
  id            String        @id @default(uuid())
  jewelleryType JewelleryType
  sizeSystem    String // US, UK, EU, MM
  region        MarketRegion
  sizeLabel     String // "7", "O", "55", "17.3mm"
  sizeValue     Float // numeric sort value
  diameterMm    Float? // inner diameter in mm
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  @@unique([jewelleryType, sizeSystem, region, sizeLabel])
  @@index([jewelleryType, region])
}

enum ConversationStatus {
  ACTIVE
  LOCKED // Locked due to violations
  ARCHIVED // Completed / closed
}

enum RefundStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

// ═══════════════════════════════════════════
// SUPPORT TICKET SYSTEM
// ═══════════════════════════════════════════

model SupportTicket {
  id           String         @id @default(uuid())
  ticketNumber String         @unique // e.g. TKT-00001
  userId       String? // null for guest tickets (from public help page)
  guestEmail   String? // for non-logged-in users
  guestName    String? // for non-logged-in users
  type         TicketType
  subject      String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)

  // Assignment
  assigneeId String? // support/admin who claimed this
  claimedAt  DateTime?

  // Context (optional references)
  orderId        String? // related order
  conversationId String? // related chat conversation

  // Resolution
  resolvedAt     DateTime?
  closedAt       DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User?           @relation("UserTickets", fields: [userId], references: [id])
  assignee User?           @relation("AssignedTickets", fields: [assigneeId], references: [id])
  messages TicketMessage[]

  @@index([userId])
  @@index([assigneeId])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([createdAt])
  @@index([ticketNumber])
}

model TicketMessage {
  id             String   @id @default(uuid())
  ticketId       String
  senderId       String? // null for system messages or guest messages
  senderRole     String // CUSTOMER, SHOPKEEPER, SUPPORT, ADMIN, SYSTEM, GUEST, AI_BOT
  senderName     String? // display name (for guests or bot)
  content        String
  attachmentUrl  String?
  attachmentType String? // image, document, video
  isInternal     Boolean  @default(false) // internal notes visible only to support/admin
  createdAt      DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User?         @relation("TicketMessageSender", fields: [senderId], references: [id])

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
  @@index([ticketId, createdAt])
}

// ============================================
// Static Pages - CMS for footer/info pages
// ============================================

model StaticPage {
  id              String   @id @default(uuid())
  slug            String   @unique // e.g. "privacy", "terms", "refund"
  title           String
  content         String   @db.Text // Rich HTML content
  metaDescription String?
  isPublished     Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
}

// ═══════════════════════════════════════════
// SELLER CATALOGUE SYSTEM
// ═══════════════════════════════════════════

model Catalogue {
  id           String        @id @default(cuid())
  shopId       String
  name         String
  slug         String        @unique
  description  String?
  isPublic     Boolean       @default(true)
  mode         CatalogueMode @default(NORMAL)
  passwordHash String? // bcrypt hash if password-protected
  expiresAt    DateTime?
  deletedAt    DateTime? // soft delete
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  shop       Shop                 @relation(fields: [shopId], references: [id])
  items      CatalogueItem[]
  viewEvents CatalogueViewEvent[]

  @@index([shopId])
  @@index([slug])
  @@index([shopId, deletedAt])
}

model CatalogueItem {
  id              String   @id @default(cuid())
  catalogueId     String
  inventoryItemId String
  sortOrder       Int      @default(0)
  overridePrice   Float? // optional override display price
  isHidden        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  catalogue     Catalogue     @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([catalogueId])
  @@index([inventoryItemId])
  @@index([catalogueId, sortOrder])
}

model CatalogueViewEvent {
  id           String   @id @default(cuid())
  catalogueId  String
  viewedAt     DateTime @default(now())
  viewerIpHash String? // sha256(ip + salt); never raw IP
  userAgent    String?
  referrer     String?
  count        Int      @default(1)

  catalogue Catalogue @relation(fields: [catalogueId], references: [id], onDelete: Cascade)

  @@index([catalogueId, viewedAt])
  @@index([catalogueId, viewerIpHash])
}

model ShowroomSession {
  id             String   @id @default(cuid())
  conversationId String?
  shopId         String
  status         String   @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  items          Json // [{ inventoryItemId, variantId?, qty? }]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([conversationId])
}

// ─── POS / Wishlist Models ───

enum PosSessionStatus {
  ACTIVE
  CHECKED_OUT
  CANCELLED
  EXPIRED
}

model WishlistItem {
  id              String   @id @default(cuid())
  userId          String
  inventoryItemId String
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([userId, inventoryItemId])
  @@index([userId])
  @@index([inventoryItemId])
}

model PosRegister {
  id             String   @id @default(uuid())
  shopId         String
  name           String
  terminalCode   String?
  active         Boolean  @default(true)
  hardwareConfig Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop     Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shifts   PosShift[]
  sessions PosSession[]
  invoices Invoice[]
  returns  PosReturn[]

  @@unique([shopId, terminalCode])
  @@index([shopId, active])
}

model PosShift {
  id             String    @id @default(uuid())
  shopId         String
  registerId     String
  openedByUserId String
  closedByUserId String?
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  openingCash    Decimal   @default(0) @db.Decimal(18, 2)
  closingCash    Decimal?  @db.Decimal(18, 2)
  expectedCash   Decimal?  @db.Decimal(18, 2)
  variance       Decimal?  @db.Decimal(18, 2)
  notes          String?
  status         String    @default("OPEN")
  summary        Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  register     PosRegister  @relation(fields: [registerId], references: [id], onDelete: Cascade)
  openedByUser User         @relation("ShiftOpenedBy", fields: [openedByUserId], references: [id])
  closedByUser User?        @relation("ShiftClosedBy", fields: [closedByUserId], references: [id])
  sessions     PosSession[]
  invoices     Invoice[]
  returns      PosReturn[]

  @@index([shopId, status])
  @@index([registerId, status])
}

model PosReturn {
  id                    String   @id @default(uuid())
  shopId                String
  invoiceId             String
  originalInvoiceNumber String
  registerId            String?
  shiftId               String?
  cashierUserId         String?
  returnIdempotencyKey  String?  @unique
  returnType            String   @default("RETURN") // RETURN, EXCHANGE
  exchangeInvoiceId     String?
  lines                 Json
  subtotal              Decimal  @db.Decimal(18, 2)
  taxAmount             Decimal  @default(0) @db.Decimal(18, 2)
  refundAmount          Decimal  @db.Decimal(18, 2)
  refundMethod          String   @default("CASH")
  refundStatus          String   @default("SETTLED") // SETTLED, PENDING, CREDIT_ISSUED
  disposition           String   @default("RESTOCK") // RESTOCK, QUARANTINE, REPAIR, SCRAP
  approvedByUserId      String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  shop           Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invoice        Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  register       PosRegister?     @relation(fields: [registerId], references: [id], onDelete: SetNull)
  shift          PosShift?        @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  cashierUser    User?            @relation("PosReturnCashier", fields: [cashierUserId], references: [id], onDelete: SetNull)
  refundPayments InvoicePayment[] @relation("PosReturnRefundPayments")

  @@index([shopId, createdAt])
  @@index([invoiceId])
  @@index([registerId, shiftId])
}

model PosSession {
  id             String           @id @default(cuid())
  shopId         String
  registerId     String?
  cashierUserId  String?
  shiftId        String?
  customerId     String?
  conversationId String?
  status         PosSessionStatus @default(ACTIVE)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  shop              Shop               @relation(fields: [shopId], references: [id])
  register          PosRegister?       @relation(fields: [registerId], references: [id], onDelete: SetNull)
  shift             PosShift?          @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  items             PosSessionItem[]
  stockReservations StockReservation[]
  Invoice           Invoice[]

  @@index([shopId, status])
  @@index([registerId, status])
  @@index([expiresAt])
}

model PosSessionItem {
  id              String   @id @default(cuid())
  posSessionId    String
  inventoryItemId String
  variantId       String?
  qty             Int      @default(1)
  unitPrice       Float
  lineTotal       Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  posSession    PosSession      @relation(fields: [posSessionId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([posSessionId])
}

model StockReservation {
  id              String   @id @default(cuid())
  shopId          String
  posSessionId    String
  inventoryItemId String
  variantId       String?
  qty             Int
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  shop          Shop            @relation(fields: [shopId], references: [id])
  posSession    PosSession      @relation(fields: [posSessionId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([posSessionId])
  @@index([expiresAt])
  @@index([inventoryItemId, variantId])
}

enum TicketType {
  ACCOUNT_SUSPENSION // suspended account appeal
  LOGIN_ISSUE // can't login
  PASSWORD_RECOVERY // forgot password / hacked account
  HACKED_ACCOUNT // account compromise
  ORDER_ISSUE // problem with order
  REFUND_ISSUE // refund dispute
  PAYMENT_ISSUE // payment problem
  PRODUCT_ISSUE // product quality / mismatch
  SHIPPING_ISSUE // delivery problem
  SELLER_COMPLAINT // complaint about seller
  BUYER_COMPLAINT // complaint about buyer
  PLATFORM_BUG // technical issue
  FEATURE_REQUEST // feature suggestion
  KYC_VERIFICATION // KYC help
  OTHER // general inquiry
}

enum TicketStatus {
  OPEN // newly created, unclaimed
  CLAIMED // claimed by support/admin
  IN_PROGRESS // being worked on
  WAITING_USER // waiting for user response
  RESOLVED // resolved by support
  CLOSED // confirmed closed
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ═══════════════════════════════════════════
// SUBSCRIPTION & BILLING SYSTEM
// ═══════════════════════════════════════════

model SubscriptionPlan {
  id           String       @id @default(uuid())
  name         String // FREE, PRO, PRO_PLUS, ENTERPRISE, etc.
  displayName  String // "Free Plan", "Pro Plan", etc.
  description  String?
  country      MarketRegion // IN, NP, AE, UK, EU, US
  currency     CurrencyCode
  monthlyPrice Float // 0 for free plan
  annualPrice  Float? // optional discounted annual price

  // ─── Resource Limits (null = unlimited) ─────────────────────────────
  maxProducts         Int? // max inventory items (products) per shop — ENFORCED by PlanLimitsService.checkProductLimit
  maxInvoicesPerMonth Int? // max invoices/bills per calendar month
  maxCatalogues       Int? // max catalogues per shop
  catalogueLimit      Int? // max items per single catalogue
  maxOrdersPerMonth   Int? // max orders per calendar month

  // ─── Soft-limit nudge thresholds (null = no nudge for that metric) ──
  // These NEVER block anything. They only decide when the gentle, dismissible
  // "you're outgrowing free → upgrade" nudge appears (fires at ~80% of the
  // value). Read per-plan by PlanLimitsService.getConversionSignals so each
  // market (region plan) is tuned independently from the admin pricing panel.
  softLimitCustomers        Int? // e.g. 100 customers
  softLimitInvoicesPerMonth Int? // e.g. 50 bills this month
  softLimitProducts         Int? // e.g. 100 products
  softLimitSavingsSchemes   Int? // e.g. 5 savings schemes

  commissionPercent Float // e.g. 5.0 = 5%
  includesAi        Boolean         @default(false)
  monthlyAiCredits  Int             @default(0)
  rolloverCap       Int             @default(0) // max credits that can roll over month-to-month
  extraCreditPrice  Float           @default(0) // price per extra AI generation
  overageBehavior   OverageBehavior @default(BLOCK) // what happens when credits run out
  features          Json? // Boolean feature flags keyed by feature id. A feature is ENABLED only when features[key] === true (missing key = blocked). Keys: invoicing, mobilePOS, mobileCatalogue, mobileRepairs, mobileSavings, karigarSupplyChain, lending, etc. See PlanLimitsService.FEATURE_LABELS for the authoritative list.
  isActive          Boolean         @default(true)
  sortOrder         Int             @default(0)

  // ─── Display Customization (admin-editable) ─────────────────────────
  badgeText   String? // e.g. "Most Popular", "Best Value", shown on pricing page
  buttonColor String? // e.g. "#f59e0b", hex color for CTA button on pricing page

  // ─── Plan Succession ────────────────────────────────────────────────
  successorPlanId String? // when disabled, point users to this replacement plan
  successorPlan   SubscriptionPlan?  @relation("PlanSuccessor", fields: [successorPlanId], references: [id])
  predecessors    SubscriptionPlan[] @relation("PlanSuccessor")

  // ─── Stripe Billing IDs ────────────────────────────────────────────
  stripeProductId     String? // Stripe Product ID (prod_xxx)
  stripePriceId       String? // Stripe monthly recurring Price ID (price_xxx)
  stripeAnnualPriceId String? // Stripe annual recurring Price ID (price_xxx)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions SellerSubscription[]
  planQuotes    PlanQuote[]

  @@unique([name, country])
  @@index([country, isActive])
  @@index([isActive, sortOrder])
}

model SellerSubscription {
  id                   String             @id @default(uuid())
  shopId               String
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  startedAt            DateTime           @default(now())
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  expiresAt            DateTime? // hard expiry (for non-renewing)
  cancelledAt          DateTime?
  cancelReason         String?
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  country              MarketRegion
  autoRenew            Boolean            @default(true)

  // ─── Plan Migration ─────────────────────────────────────────────────
  migrationStatus      MigrationStatus @default(NONE)
  migrationNotifiedAt  DateTime? // when the first migration email was sent
  migrationNotifyCount Int             @default(0) // how many follow-up emails sent

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop     Shop                  @relation(fields: [shopId], references: [id])
  plan     SubscriptionPlan      @relation(fields: [planId], references: [id])
  payments SubscriptionPayment[]

  @@index([shopId])
  @@index([planId])
  @@index([status])
  @@index([stripeSubscriptionId])
  @@index([currentPeriodEnd])
  @@index([migrationStatus])
}

/// One-time service-recovery entitlement offered to a shop after a verified
/// incident. Only a SHA-256 hash of the bearer token is stored.
model RecoveryOffer {
  id                    String              @id @default(cuid())
  campaignKey           String
  userId                String
  shopId                String
  email                 String
  tokenHash             String              @unique @db.VarChar(64)
  days                  Int                 @default(40)
  status                RecoveryOfferStatus @default(PREPARED)
  sourceReportIds       String[]
  expiresAt             DateTime
  scheduledFor          DateTime?
  sentAt                DateTime?
  deliveredAt           DateTime?
  firstOpenedAt         DateTime?
  lastOpenedAt          DateTime?
  openCount             Int                 @default(0)
  firstClickedAt        DateTime?
  lastClickedAt         DateTime?
  clickCount            Int                 @default(0)
  bouncedAt             DateTime?
  complainedAt          DateTime?
  failedAt              DateTime?
  suppressedAt          DateTime?
  claimedAt             DateTime?
  grantedSubscriptionId String?
  deliveryMessageId     String?
  failureReason         String?             @db.Text
  createdBy             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop        Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  emailEvents RecoveryOfferEmailEvent[]

  @@unique([campaignKey, shopId])
  @@index([campaignKey, sentAt])
  @@index([deliveryMessageId])
  @@index([status, createdAt])
  @@index([status, scheduledFor])
  @@index([userId])
  @@index([shopId])
  @@index([expiresAt])
}

model OfferCampaign {
  id                String                    @id @default(cuid())
  key               String                    @unique
  name              String
  kind              OfferCampaignKind
  complimentaryDays Int
  discountPercent   Float                     @default(0)
  startsAt          DateTime
  endsAt            DateTime
  emailSubject      String
  emailHeading      String
  emailBody         String                    @db.Text
  imageUrl          String?
  isActive          Boolean                   @default(true)
  createdBy         String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  redemptions       OfferCampaignRedemption[]

  @@index([kind, isActive, startsAt, endsAt])
  @@index([endsAt])
}

/// Sales inquiry raised from the billing page ("contact sales" for Pro+ /
/// Enterprise). Admins answer with a custom PlanQuote.
model PlanInquiry {
  id        String            @id @default(cuid())
  shopId    String
  userId    String
  planName  String
  message   String?           @db.Text
  status    PlanInquiryStatus @default(NEW)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  shop  Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote PlanQuote?

  @@unique([id, shopId])
  @@index([status, createdAt])
  @@index([shopId])
}

/// Custom-priced plan quote prepared by an admin and emailed to the shop.
/// Accepting it runs Stripe Checkout against a one-off Stripe Price created
/// for the quoted amount.
model PlanQuote {
  id                     String          @id @default(cuid())
  token                  String          @unique
  shopId                 String
  planId                 String
  inquiryId              String?         @unique
  monthlyPrice           Float?
  annualPrice            Float?
  validUntil             DateTime
  notes                  String?         @db.Text
  status                 PlanQuoteStatus @default(SENT)
  monthlyPriceId         String? // Stripe Price for the quoted monthly amount
  annualPriceId          String? // Stripe Price for the quoted annual amount
  redeemedAt             DateTime?
  redeemedSubscriptionId String?
  createdBy              String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  shop    Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])
  // createQuote looks up inquiries by id AND shopId so a quote cannot
  // attach another shop's inquiry. Prisma cannot model an optional
  // composite FK while shopId stays required.
  inquiry PlanInquiry?     @relation(fields: [inquiryId], references: [id], onDelete: Restrict)

  @@index([shopId, status])
  @@index([status, validUntil])
}

enum PlanInquiryStatus {
  NEW
  QUOTED
  CLOSED
}

enum PlanQuoteStatus {
  SENT
  REDEEMED
  REVOKED
}

model OfferCampaignRedemption {
  id                String                        @id @default(cuid())
  campaignId        String
  shopId            String
  discountPercent   Float
  status            OfferCampaignRedemptionStatus @default(RESERVED)
  stripeSessionId   String?                       @unique
  reservationEndsAt DateTime?
  redeemedAt        DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  campaign OfferCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  shop     Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([campaignId, shopId])
  @@index([shopId, status])
  @@index([status, reservationEndsAt])
}

/// Deduplicated Resend delivery and engagement events for recovery campaigns.
/// Click destinations and recipient device details are intentionally not stored.
model RecoveryOfferEmailEvent {
  id        String   @id @default(cuid())
  webhookId String   @unique
  offerId   String
  type      String
  eventAt   DateTime
  linkKind  String?
  createdAt DateTime @default(now())

  offer RecoveryOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, eventAt])
  @@index([type, eventAt])
}

model SubscriptionPayment {
  id               String        @id @default(uuid())
  subscriptionId   String
  amount           Float
  currency         CurrencyCode
  gateway          String // "stripe", "phonepe", "manual"
  gatewayPaymentId String?
  status           PaymentStatus @default(PENDING)
  periodStart      DateTime
  periodEnd        DateTime
  invoiceUrl       String?
  failureReason    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  subscription SellerSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([gatewayPaymentId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  TRIALING
}

enum RecoveryOfferStatus {
  PREPARED
  SENT
  CLAIMING
  CLAIMED
  SEND_FAILED
  CANCELLED
  EXPIRED
}

enum OfferCampaignKind {
  RECOVERY
  FESTIVAL
}

enum OfferCampaignRedemptionStatus {
  RESERVED
  REDEEMED
  RELEASED
}

enum MigrationStatus {
  NONE // no migration pending
  PENDING // notified, awaiting response
  ACCEPTED // user accepted migration to successor plan
  DECLINED // user declined, will downgrade to FREE at period end
}

enum OverageBehavior {
  BLOCK // Block generation when credits run out
  AUTO_CHARGE // Auto-charge extraCreditPrice via Stripe
}

// ═══════════════════════════════════════════
// AI CREDIT SYSTEM
// ═══════════════════════════════════════════

model AiCreditLedger {
  id             String       @id @default(uuid())
  userId         String
  shopId         String?
  action         CreditAction
  amount         Decimal      @db.Decimal(12, 2) // always positive; action determines direction
  balanceBefore  Decimal      @db.Decimal(12, 2)
  balanceAfter   Decimal      @db.Decimal(12, 2)
  reason         String? // "monthly_grant", "image_gen", "admin_adjustment", "overage_charge", "expiry"
  referenceId    String? // designId, subscriptionPaymentId, etc.
  idempotencyKey String?      @unique
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([shopId, createdAt])
  @@index([idempotencyKey])
  @@index([action])
}

enum CreditAction {
  GRANT // Monthly/admin grant
  DEBIT // Used for generation
  REFUND // Failed generation refund
  EXPIRE // End-of-period expiry beyond rollover cap
  ADMIN_ADJUST // Manual admin adjustment
  OVERAGE // Extra credit purchased (auto-charge)
  PURCHASE // Manually purchased extra credits
}

// ═══════════════════════════════════════════
// PAYMENT GATEWAY CONFIGURATION
// ═══════════════════════════════════════════

model PaymentGatewayConfig {
  id                 String          @id @default(uuid())
  gatewayName        String // "stripe", "phonepe", "razorpay", "esewa", "khalti"
  displayName        String // "Stripe", "PhonePe", etc.
  isEnabled          Boolean         @default(false)
  isDefault          Boolean         @default(false) // fallback gateway when no country match
  supportedCountries MarketRegion[]
  supportedMethods   PaymentMethod[] // CARD, UPI, BANK_TRANSFER, etc.
  priority           Int             @default(0) // higher = preferred when multiple gateways available
  envKeyLabel        String // reference label: "STRIPE_SECRET_KEY", "PHONEPE_MERCHANT_ID" — never the actual value
  envKeysRequired    Json? // JSON array of env key names: ["STRIPE_SECRET_KEY","STRIPE_WEBHOOK_SECRET"]
  commissionInfo     String? // human-readable: "1.5% + ₹2 per txn"
  webhookEndpoint    String? // e.g. "/api/webhooks/stripe"
  updatedBy          String?
  updatedAt          DateTime        @updatedAt
  createdAt          DateTime        @default(now())

  @@unique([gatewayName])
  @@index([isEnabled])
  @@index([isDefault])
  @@index([priority])
}

// ═══════════════════════════════════════════
// ENTERPRISE FEATURES
// ═══════════════════════════════════════════

// Multi-branch support — single enterprise account managing multiple locations
model ShopBranch {
  id            String   @id @default(uuid())
  shopId        String
  branchName    String
  branchCode    String // e.g. "KTM-01", "BLR-MAIN"
  country       String
  state         String?
  city          String
  address       String
  pincode       String?
  latitude      Float?
  longitude     Float?
  contactPhone  String
  contactEmail  String?
  isActive      Boolean  @default(true)
  isHeadquarter Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, branchCode])
  @@index([shopId, isActive])
  @@index([country, city])
}

// Staff sub-accounts with granular permissions
model StaffAccount {
  id              String    @id @default(uuid())
  shopId          String
  userId          String
  staffRole       StaffRole
  permissions     Json // e.g. { "inventory": true, "orders": true, "billing": false }
  branchIds       String[] // which branches this staff can access; empty = all
  isActive        Boolean   @default(true)
  invitedByUserId String
  invitedAt       DateTime  @default(now())
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId, isActive])
  @@index([userId])
}

enum StaffRole {
  MANAGER // Full access to branch operations
  INVENTORY // Inventory + catalogue management only
  CASHIER // POS + order processing only
  VIEWER // Read-only dashboard access
  AUDITOR // Read-only + audit log + reports
}

// API key management for enterprise integrations
model ShopApiKey {
  id              String    @id @default(uuid())
  shopId          String
  keyName         String // e.g. "ERP Sync", "POS Integration"
  kind            String    @default("INTEGRATION") // INTEGRATION | SELLER_AI
  keyHash         String // sha256 hash of the API key (not the raw key)
  keyPrefix       String // first 8 chars to identify key: "ovrk_xxxx"
  scopes          String[] // e.g. ["inventory:read", "orders:read", "orders:write"]
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  lastUsedIp      String?
  isActive        Boolean   @default(true)
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, isActive])
  @@index([keyPrefix])
}

enum SellerAiActionStatus {
  PENDING
  PROCESSING
  CONFIRMED
  REJECTED
  EXPIRED
  FAILED
}

// A write proposed by a seller-connected AI. The AI key can request it, but
// only a logged-in shopkeeper can confirm it from the dashboard.
model SellerAiAction {
  id                String               @id @default(uuid())
  shopId            String
  apiKeyId          String
  keyPrefix         String
  toolName          String
  actionType        String
  summary           String
  payload           Json
  status            SellerAiActionStatus @default(PENDING)
  expiresAt         DateTime
  confirmedByUserId String?
  confirmedAt       DateTime?
  rejectedByUserId  String?
  rejectedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, status, createdAt])
  @@index([shopId, status, expiresAt])
  @@index([apiKeyId, createdAt])
  @@index([expiresAt])
}

// Webhook subscriptions for enterprise event push
model WebhookSubscription {
  id              String         @id @default(uuid())
  shopId          String
  url             String // HTTPS endpoint URL
  secret          String // HMAC secret for signature verification
  events          WebhookEvent[] // which events to fire
  isActive        Boolean        @default(true)
  failureCount    Int            @default(0) // consecutive failures; disabled after 10
  lastDeliveredAt DateTime?
  lastFailedAt    DateTime?
  lastHttpStatus  Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, isActive])
}

enum WebhookEvent {
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_COMPLETED
  ORDER_CANCELLED
  PAYMENT_RECEIVED
  INVENTORY_LOW_STOCK
  INVENTORY_UPDATED
  RFQ_RECEIVED
  OFFER_ACCEPTED
  PRICE_ALERT
  SUBSCRIPTION_CHANGED
}

// White-label / custom branding config
model WhiteLabelConfig {
  id              String   @id @default(uuid())
  shopId          String   @unique
  customDomain    String?  @unique // e.g. "shop.mybrand.com"
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String? // hex e.g. "#D4AF37"
  secondaryColor  String?
  accentColor     String?
  fontFamily      String? // Google Fonts name
  headerHtml      String? // custom HTML for storefront header
  footerHtml      String? // custom HTML for storefront footer
  hideOrivraa     Boolean  @default(false) // hide "Powered by OriVraa"
  customCss       String? // extra CSS overrides
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

// Scheduled report config
model ScheduledReport {
  id              String          @id @default(uuid())
  shopId          String
  reportType      ReportType
  frequency       ReportFrequency
  recipients      String[] // email addresses
  format          ReportFormat    @default(PDF)
  filters         Json? // date range, categories, branches, etc.
  isActive        Boolean         @default(true)
  lastSentAt      DateTime?
  nextRunAt       DateTime?
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, isActive])
  @@index([nextRunAt])
}

model BackupSchedule {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  cronExp   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive])
  @@index([createdAt])
}

enum ReportType {
  SALES_SUMMARY
  INVENTORY_STATUS
  COMMISSION_STATEMENT
  CUSTOMER_ANALYTICS
  REVENUE_TREND
  TAX_REPORT
  STAFF_PERFORMANCE
}

enum ReportFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

enum ReportFormat {
  PDF
  EXCEL
  CSV
}

// Bulk import/export job tracking
model BulkImportJob {
  id              String         @id @default(uuid())
  shopId          String
  importType      BulkImportType
  status          BulkJobStatus  @default(PENDING)
  fileUrl         String // R2 URL of uploaded file
  totalRows       Int?
  processedRows   Int            @default(0)
  successRows     Int            @default(0)
  failedRows      Int            @default(0)
  errorLog        Json? // array of { row, field, message }
  resultFileUrl   String? // URL of result/error file
  startedAt       DateTime?
  completedAt     DateTime?
  createdByUserId String
  createdAt       DateTime       @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@index([createdAt])
}

enum BulkImportType {
  INVENTORY_ITEMS
  PRODUCT_VARIANTS
  CUSTOMER_LIST
  PRICE_SHEET
  CATALOGUE_ITEMS
}

enum BulkJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// AI demand forecasting results
model DemandForecast {
  id              String   @id @default(uuid())
  shopId          String
  period          String // "2026-03", "2026-Q1"
  category        String // jewellery type, karat, etc.
  predictedDemand Int
  confidenceScore Float // 0-1
  factors         Json? // { "seasonal": 0.3, "trend": 0.5, "promotion": 0.2 }
  recommendation  String? // AI-generated recommendation text
  createdAt       DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, period])
  @@index([category])
}

// Automated repricing rules
model RepricingRule {
  id              String        @id @default(uuid())
  shopId          String
  ruleName        String
  ruleType        RepricingType
  conditions      Json // e.g. { "metalType": "GOLD", "karat": 24, "marginMin": 3 }
  action          Json // e.g. { "adjustPercent": -2, "roundTo": 10 }
  isActive        Boolean       @default(true)
  priority        Int           @default(0)
  lastTriggeredAt DateTime?
  triggerCount    Int           @default(0)
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, isActive])
}

enum RepricingType {
  GOLD_RATE_CHANGE // trigger when gold rate changes by X%
  LOW_STOCK // mark up when stock < threshold
  COMPETITOR_MATCH // match competitor pricing
  TIME_BASED // scheduled discounts (e.g. weekend sale)
  DEMAND_BASED // AI-driven demand elasticity
}

// ─── Performance Monitoring ───

// Stores periodic snapshots of Prometheus metrics for historical charts
model MetricsSnapshot {
  id            String   @id @default(uuid())
  // Core request metrics
  requests      Int      @default(0)
  errors        Int      @default(0)
  errorRate     Float    @default(0) // percentage
  // Latency in milliseconds
  avgLatency    Float    @default(0)
  p95Latency    Float    @default(0)
  p99Latency    Float    @default(0)
  // System metrics
  memoryMB      Float    @default(0)
  cpuSeconds    Float    @default(0)
  // Business metrics
  rfqsCreated   Int      @default(0)
  ordersCreated Int      @default(0)
  // Connection metrics
  wsConnections Int      @default(0)
  inFlight      Int      @default(0)
  // Uptime
  uptime        Float    @default(0) // seconds
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// ─── Cron Job Metrics ──────────────────────────────────────
model CronJobLog {
  id               String   @id @default(cuid())
  jobName          String // e.g. "metrics-snapshot", "pos-expiry", "call-scheduler"
  app              String // "api" or "team-api"
  frequency        String // e.g. "EVERY_30_MINUTES", "DAILY_3AM"
  status           String // "success", "error", "skipped"
  durationMs       Int      @default(0)
  recordsProcessed Int      @default(0)
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([jobName, createdAt])
  @@index([app, createdAt])
  @@index([createdAt])
}

model CronJobConfig {
  id              String   @id @default(cuid())
  jobName         String   @unique // e.g. "call-scheduler", "metrics-snapshot"
  app             String // "api" or "team-api"
  intervalMinutes Int // current frequency in minutes
  recommended     Int // recommended frequency in minutes
  minInterval     Int      @default(1) // minimum allowed interval
  maxInterval     Int      @default(60) // maximum allowed interval
  enabled         Boolean  @default(true)
  description     String? // human-readable description
  impact          String? // impact description for the UI
  category        String   @default("general") // "scheduling", "monitoring", "cache", "cleanup"
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// ──────────────────────────────────────────────────────────────────────────
// Mobile shopkeeper tools (offline-first capable)
//
// Both models carry an optional `clientId` (a client-generated UUID) so the
// mobile PWA — and the future native mobile app — can create records while
// offline, queue them, and replay them on reconnect without creating
// duplicates. The server upserts on `clientId`, making every write idempotent.
// ──────────────────────────────────────────────────────────────────────────

enum RepairStatus {
  RECEIVED
  DIAGNOSING
  IN_REPAIR
  READY
  DELIVERED
}

model RepairJob {
  id                String       @id @default(uuid())
  shopId            String
  clientId          String?      @unique // client-generated UUID for offline idempotency
  customerName      String
  customerPhone     String?
  itemDescription   String
  issueDescription  String
  status            RepairStatus @default(RECEIVED)
  estimatedCost     Float?
  finalCost         Float?
  expectedReadyDate DateTime?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  shop              Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, status])
  @@index([shopId, createdAt])
}

enum SavingsSchemeType {
  DAILY
  WEEKLY
  MONTHLY
}

enum SavingsMemberStatus {
  ACTIVE
  MATURED
  REDEEMED
  CANCELLED
}

model SavingsMember {
  id                String              @id @default(uuid())
  shopId            String
  clientId          String?             @unique // client-generated UUID for offline idempotency
  customerName      String
  customerPhone     String?
  schemeType        SavingsSchemeType   @default(MONTHLY)
  installmentAmount Float
  installmentsPaid  Int                 @default(0)
  totalInstallments Int
  bonusInstallments Int                 @default(0)
  currency          CurrencyCode        @default(NPR)
  startDate         DateTime
  maturityDate      DateTime
  status            SavingsMemberStatus @default(ACTIVE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  shop              Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  payments          SavingsPayment[]

  @@index([shopId])
  @@index([shopId, status])
  @@index([shopId, createdAt])
}

model SavingsPayment {
  id       String        @id @default(uuid())
  memberId String
  clientId String?       @unique // client-generated UUID for offline idempotency
  amount   Float
  paidAt   DateTime      @default(now())
  member   SavingsMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// ─── Committee chit fund (manual winner; separate from individual savings) ───
// Rotating committee ledger for jewellers. Not a regulated auction chit platform.
enum ChitGroupStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ChitCycleStatus {
  OPEN
  CLOSED
}

model ChitGroup {
  id                       String          @id @default(uuid())
  shopId                   String
  name                     String
  chitValue                Float
  memberSlots              Int
  installmentAmount        Float
  foremanCommissionPercent Float           @default(0)
  currency                 CurrencyCode    @default(NPR)
  startDate                DateTime
  status                   ChitGroupStatus @default(ACTIVE)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  shop                     Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  members                  ChitMember[]
  cycles                   ChitCycle[]

  @@index([shopId])
  @@index([shopId, status])
}

model ChitMember {
  id             String             @id @default(uuid())
  groupId        String
  ticketNumber   Int
  customerName   String
  customerPhone  String?
  hasWon         Boolean            @default(false)
  wonCycleNumber Int?
  createdAt      DateTime           @default(now())
  group          ChitGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payments       ChitCyclePayment[]
  wonCycles      ChitCycle[]        @relation("ChitCycleWinner")

  @@unique([groupId, ticketNumber])
  @@index([groupId])
}

model ChitCycle {
  id                String             @id @default(uuid())
  groupId           String
  cycleNumber       Int
  dueDate           DateTime
  status            ChitCycleStatus    @default(OPEN)
  winnerMemberId    String?
  netPrize          Float?
  foremanCommission Float?
  closedAt          DateTime?
  createdAt         DateTime           @default(now())
  group             ChitGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  winner            ChitMember?        @relation("ChitCycleWinner", fields: [winnerMemberId], references: [id], onDelete: SetNull)
  payments          ChitCyclePayment[]

  @@unique([groupId, cycleNumber])
  @@index([groupId, status])
}

model ChitCyclePayment {
  id        String     @id @default(uuid())
  cycleId   String
  memberId  String
  amount    Float
  paidAt    DateTime   @default(now())
  clientId  String?    @unique
  createdAt DateTime   @default(now())
  cycle     ChitCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  member    ChitMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([cycleId, memberId])
  @@index([cycleId])
  @@index([memberId])
}

// ─── Girvi / Gold Loan (pawn lending) ───────────────────────
enum GoldLoanStatus {
  ACTIVE
  REDEEMED
  DEFAULTED
}

model GoldLoan {
  id                String         @id @default(uuid())
  shopId            String
  clientId          String?        @unique // client-generated UUID for offline idempotency
  loanNumber        String
  customerName      String
  customerPhone     String?
  principal         Float
  interestRate      Float // percentage
  rateType          String         @default("MONTHLY") // MONTHLY | ANNUAL
  interestType      String         @default("SIMPLE") // SIMPLE | COMPOUND
  compoundFrequency String? // MONTHLY | QUARTERLY | ANNUALLY
  pawnedItems       Json // [{ name, purity, grossWeight, netWeight }]
  currency          CurrencyCode   @default(NPR)
  status            GoldLoanStatus @default(ACTIVE)
  loanDate          DateTime
  redeemedDate      DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  shop              Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, status])
  @@index([shopId, createdAt])
}

// ─── Karigar / Workshop supply chain ──────────────────────
enum KarigarStage {
  CASTING
  FILING
  POLISHING
  SETTING
  FINAL_POLISH
  QC
}

enum KarigarMovementType {
  ISSUE
  TRANSFER
  RETURN_FINISHED
  RETURN_UNUSED
  RETURN_SPRUE
  SCRAP
  DUST
  ADJUST
}

enum KarigarFinancialEntryType {
  OPENING_BALANCE
  WAGE_ACCRUAL
  SETTLEMENT_PAYMENT
  ADVANCE_PAYMENT
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
}

model KarigarWorkshop {
  id                 String                  @id // client-generated id (e.g. ws-...)
  shopId             String
  name               String
  artisan            String
  location           String                  @default("Local")
  phone              String?
  email              String?
  rating             Float                   @default(5)
  metalIssued        Float                   @default(0)
  metalReturned      Float                   @default(0)
  wastagePercent     Float                   @default(0)
  wastageLimit       Float                   @default(1)
  wageRatePerGram    Float                   @default(0)
  outstandingBalance Float                   @default(0)
  wageDue            Float                   @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  shop               Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  jobs               KarigarJob[]
  movements          KarigarMetalMovement[]
  stages             KarigarJobStage[]
  financialEntries   KarigarFinancialEntry[]

  @@index([shopId])
}

model KarigarJob {
  id                    String                       @id // client-generated id (e.g. job-...)
  shopId                String
  workshopId            String?
  product               String
  artisan               String
  grossWeight           Float                        @default(0)
  metalKey              String                       @default("goldGrains24k")
  allowedWastagePercent Float                        @default(1)
  status                String                       @default("PENDING")
  steps                 Json? // legacy checkboxes; stages table is source of truth
  walkInCustomerId      String?
  shopQuoteId           String?
  inventoryItemId       String?                      @unique
  dueAt                 DateTime?
  priority              String                       @default("NORMAL")
  qty                   Int                          @default(1)
  sizeLabel             String?
  purity                String?
  metalColor            String?
  photos                String[]                     @default([])
  notes                 String?
  bom                   Json?
  currentStage          KarigarStage?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  shop                  Shop                         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  workshop              KarigarWorkshop?             @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  walkInCustomer        WalkInCustomer?              @relation(fields: [walkInCustomerId], references: [id], onDelete: SetNull)
  shopQuote             ShopQuote?                   @relation(fields: [shopQuoteId], references: [id], onDelete: SetNull)
  inventoryItem         InventoryItem?               @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  stages                KarigarJobStage[]
  movements             KarigarMetalMovement[]
  trees                 KarigarCastingTree[]
  financialEntries      KarigarFinancialEntry[]
  financialAllocations  KarigarFinancialAllocation[]

  @@index([shopId])
  @@index([workshopId])
  @@index([shopId, currentStage])
  @@index([walkInCustomerId])
  @@index([shopQuoteId])
}

model KarigarJobStage {
  id                    String           @id @default(uuid())
  shopId                String
  jobId                 String
  workshopId            String?
  stage                 KarigarStage
  goldInGrams           Float            @default(0)
  goldOutGrams          Float            @default(0)
  scrapGrams            Float            @default(0)
  dustGrams             Float            @default(0)
  allowedWastagePercent Float            @default(1)
  status                String           @default("PENDING")
  notes                 String?
  photos                String[]         @default([])
  reworkCount           Int              @default(0)
  rejectionReason       String?
  /// Set only by the dedicated Workshop QC approval flow.
  qcApprovedAt          DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  shop                  Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  job                   KarigarJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workshop              KarigarWorkshop? @relation(fields: [workshopId], references: [id], onDelete: SetNull)

  @@unique([jobId, stage])
  @@index([shopId, jobId])
}

model KarigarCastingTree {
  id                    String                   @id @default(uuid())
  shopId                String
  jobId                 String
  label                 String                   @default("Tree")
  metalKey              String                   @default("goldGrains24k")
  purity                String                   @default("24K")
  issuedGrams           Float                    @default(0)
  finishedGrams         Float                    @default(0)
  sprueButtonGrams      Float                    @default(0)
  recoverableGrams      Float                    @default(0)
  allowedWastagePercent Float                    @default(1)
  status                String                   @default("OPEN")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  shop                  Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  job                   KarigarJob               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lines                 KarigarCastingTreeLine[]
  movements             KarigarMetalMovement[]

  @@index([shopId, jobId])
}

model KarigarCastingTreeLine {
  id          String             @id @default(uuid())
  treeId      String
  label       String
  weightGrams Float              @default(0)
  sortOrder   Int                @default(0)
  tree        KarigarCastingTree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@index([treeId])
}

model KarigarMetalMovement {
  id                 String                 @id @default(uuid())
  shopId             String
  workshopId         String?
  jobId              String?
  treeId             String?
  stage              KarigarStage?
  type               KarigarMovementType
  metalKey           String                 @default("goldGrains24k")
  weightGrams        Float
  purity             String?
  lotId              String?
  note               String?
  idempotencyKey     String?                @db.VarChar(191)
  requestFingerprint String?                @db.VarChar(64)
  createdBy          String?
  createdAt          DateTime               @default(now())
  shop               Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  workshop           KarigarWorkshop?       @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  job                KarigarJob?            @relation(fields: [jobId], references: [id], onDelete: Restrict)
  tree               KarigarCastingTree?    @relation(fields: [treeId], references: [id], onDelete: SetNull)
  financialEntry     KarigarFinancialEntry?

  @@unique([shopId, idempotencyKey])
  @@index([shopId, createdAt])
  @@index([jobId])
  @@index([workshopId])
}

model KarigarVaultReserve {
  id          String   @id @default(uuid())
  shopId      String
  materialKey String // vault key, e.g. goldGrains24k or a custom key
  label       String   @default("")
  customKey   String? // present for custom materials (the material `key`)
  quantity    Float    @default(0)
  isCustom    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, materialKey])
  @@index([shopId])
}

model KarigarFinancialEntry {
  id                 String                    @id @default(uuid())
  shopId             String
  workshopId         String
  jobId              String?
  type               KarigarFinancialEntryType
  amount             Decimal                   @db.Decimal(18, 2)
  currency           CurrencyCode              @default(NPR)
  paymentMethod      String?                   @db.VarChar(50)
  reference          String?                   @db.VarChar(120)
  note               String?                   @db.VarChar(1000)
  sourceMovementId   String?                   @unique
  idempotencyKey     String?                   @db.VarChar(191)
  requestFingerprint String?                   @db.VarChar(64)
  createdBy          String?
  createdAt          DateTime                  @default(now())

  shop           Shop                         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  workshop       KarigarWorkshop              @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  job            KarigarJob?                  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  sourceMovement KarigarMetalMovement?        @relation(fields: [sourceMovementId], references: [id], onDelete: SetNull)
  allocations    KarigarFinancialAllocation[]

  @@unique([shopId, idempotencyKey])
  @@index([shopId, workshopId, createdAt])
  @@index([workshopId])
  @@index([jobId])
}

model KarigarFinancialAllocation {
  id               String   @id @default(uuid())
  shopId           String
  financialEntryId String
  jobId            String
  amount           Decimal  @db.Decimal(18, 2)
  createdAt        DateTime @default(now())

  shop           Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  financialEntry KarigarFinancialEntry @relation(fields: [financialEntryId], references: [id], onDelete: Cascade)
  job            KarigarJob            @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([financialEntryId, jobId])
  @@index([shopId])
  @@index([jobId])
}

// ─── Security Shield ───────────────────────────────────────
model SecurityEvent {
  id        String   @id @default(cuid())
  type      String // AUTH_BRUTE_FORCE, INPUT_INJECTION, ENUM_SCRAPING, etc.
  severity  String // CRITICAL, HIGH, MEDIUM, LOW, INFO
  ip        String
  userId    String?
  route     String
  method    String
  userAgent String?
  details   Json?
  blocked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([type, createdAt])
  @@index([severity, createdAt])
}

model BlockedIp {
  id        String    @id @default(cuid())
  ip        String    @unique
  reason    String
  severity  String    @default("HIGH")
  autoBlock Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([ip])
  @@index([expiresAt])
}

model WhitelistedIp {
  id        String   @id @default(cuid())
  ip        String   @unique
  label     String   @default("") // e.g. "Admin Home", "Office VPN"
  addedBy   String? // userId of admin who added it
  createdAt DateTime @default(now())

  @@index([ip])
}

// ─── Crash Reports (client-side error reporting) ───────────
model CrashReport {
  id              String   @id @default(cuid())
  errorMessage    String   @db.Text
  errorStack      String?  @db.Text
  page            String // URL/path where the crash happened
  userAction      String?  @db.Text // what the user was doing (button click, navigation, etc.)
  platform        String // "web" | "desktop"
  userRole        String? // ADMIN | CUSTOMER | SHOPKEEPER | guest
  userId          String? // if logged in
  userAgent       String?  @db.Text
  appVersion      String? // desktop app version
  ip              String? // client IP address (recorded server-side)
  status          String   @default("new") // new | reviewed | resolved (shown as Fixed in admin)
  adminNotes      String?  @db.Text
  // User-initiated report fields
  userTriggered   Boolean  @default(false) // true = user manually clicked Report
  userDescription String?  @db.Text // user's own description of the issue
  sessionToken    String? // link to WebSession
  screenshotUrl   String? // user-opted-in screenshot (R2 URL)
  frustrationType String? // "rage_click" | "api_error" | "manual" | "boundary"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([platform, createdAt])
  @@index([userId])
  @@index([userTriggered, createdAt])
}

// ─── App Releases & Desktop Tracking ───────────────────────
model AppRelease {
  id            String  @id @default(cuid())
  version       String // semver e.g. "0.2.0"
  platform      String // WINDOWS | MACOS | WEB
  channel       String  @default("stable") // stable | beta
  downloadUrl   String? // direct download link (Windows/macOS installers)
  fileSize      BigInt? // bytes
  fileName      String? // e.g. "Orivraa_0.2.0_x64-setup.exe"
  downloadCount Int     @default(0) // incremented on each tracked click

  // Changelog — admin can override GitHub-sourced notes
  changelog       String? @db.Text // markdown
  githubChangelog String? @db.Text // auto-pulled from GitHub release body
  changelogSource String  @default("github") // github | manual | merged

  // Version management
  isLatest Boolean @default(false) // only ONE per platform should be true
  isActive Boolean @default(true) // false = hidden from download page

  // System requirements
  minOs        String? // e.g. "Windows 10 (1809+)"
  minRam       String? // e.g. "4 GB"
  minDisk      String? // e.g. "200 MB"
  architecture String? // x64 | arm64 | universal

  // Metadata
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([version, platform])
  @@index([platform, isLatest])
  @@index([platform, isActive, publishedAt])
}

model DesktopSession {
  id            String    @id @default(cuid())
  userId        String?
  sessionToken  String    @unique // generated by Tauri at launch
  ipAddress     String
  appVersion    String
  os            String
  arch          String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  durationSec   Int? // computed on close
  lastHeartbeat DateTime  @default(now())
  isActive      Boolean   @default(true)
  closedBy      String? // "user_quit" | "heartbeat_timeout" | "crash"

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([startedAt])
  @@index([userId, startedAt])
}

// ── Platform Review Incentive ──────────────────────────────────
// Tracks seller reviews left on external platforms (G2, SaaSHub, etc.)
// for the "Review & Earn" programme — 1 approved review = 1 month Pro free.
model PlatformReview {
  id              String               @id @default(uuid())
  shopId          String
  platform        String // "saashub" | "g2" | "crunchbase"
  reviewUrl       String? // optional link to the review
  proofScreenshot String // uploaded image URL
  status          PlatformReviewStatus @default(PENDING)
  submittedAt     DateTime             @default(now())
  reviewedAt      DateTime?
  reviewedBy      String? // admin user ID
  adminNotes      String?
  rewardGranted   Boolean              @default(false)
  rewardGrantedAt DateTime?

  // Reminder tracking
  lastRemindedAt DateTime?
  reminderCount  Int       @default(0)

  shop Shop @relation(fields: [shopId], references: [id])

  @@unique([shopId, platform]) // one review per platform per shop
  @@index([status])
  @@index([shopId])
}

enum PlatformReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Referral Programme ──────────────────────────────────────────
model Referral {
  id                 String         @id @default(uuid())
  referrerShopId     String
  refereeShopId      String? // set once the referred seller creates a shop
  refereeEmail       String // email of the invited seller
  referralCode       String         @unique
  status             ReferralStatus @default(PENDING)
  referrerRewarded   Boolean        @default(false)
  refereeRewarded    Boolean        @default(false)
  referrerRewardedAt DateTime?
  refereeRewardedAt  DateTime?
  invitedAt          DateTime       @default(now())
  signedUpAt         DateTime? // when the referee registered
  planPurchasedAt    DateTime? // when the referee bought a plan
  completedAt        DateTime? // when rewards were granted

  referrerShop Shop                 @relation("ShopReferralsMade", fields: [referrerShopId], references: [id])
  refereeShop  Shop?                @relation("ShopReferralsReceived", fields: [refereeShopId], references: [id])
  commissions  ReferralCommission[]

  @@unique([referrerShopId, refereeEmail])
  @@index([referralCode])
  @@index([refereeEmail])
  @@index([status])
  @@index([referrerShopId])
}

enum ReferralStatus {
  PENDING // invitation sent, awaiting sign-up
  SIGNED_UP // referee registered but not yet verified/plan purchased
  PLAN_PURCHASED // referee bought a plan — ready for auto-completion
  COMPLETED // both rewarded
  EXPIRED // invitation expired (e.g. 90 days)
}

model ReferralSettings {
  id                  String   @id @default("singleton")
  freeMonths          Float    @default(0) // unused legacy field (kept for existing rows)
  aiCreditsReward     Int      @default(0) // unused legacy field (kept for existing rows)
  expirationDays      Int      @default(90) // referral link validity
  maxReferralsPerShop Int      @default(50) // anti-abuse cap
  isActive            Boolean  @default(true) // master switch
  commissionPercent   Float    @default(10) // % of each paid subscription invoice
  applyToInvoiceFirst Boolean  @default(true) // credit referrer's next Orivraa invoice before cash-out
  minCashoutAmount    Float    @default(10) // leftover cash-out threshold in invoice currency units
  updatedAt           DateTime @updatedAt
}

enum ReferralCommissionStatus {
  ACCRUED
  REQUESTED
  APPLIED
  PAID_OUT
  VOID
}

model ReferralCommission {
  id               String                   @id @default(uuid())
  referrerShopId   String
  refereeShopId    String
  referralId       String
  stripeInvoiceId  String                   @unique
  grossAmount      Float
  commissionAmount Float
  currency         String
  status           ReferralCommissionStatus @default(ACCRUED)
  appliedAt        DateTime?
  paidOutAt        DateTime?
  payoutId         String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  referrerShop Shop     @relation("ReferralCommissionsEarned", fields: [referrerShopId], references: [id])
  refereeShop  Shop     @relation("ReferralCommissionsGenerated", fields: [refereeShopId], references: [id])
  referral     Referral @relation(fields: [referralId], references: [id])

  @@index([referrerShopId, status])
  @@index([refereeShopId])
  @@index([referralId])
}

model ReferralPayoutProfile {
  id                     String   @id @default(uuid())
  shopId                 String   @unique
  stripeConnectAccountId String?  @unique
  detailsSubmitted       Boolean  @default(false)
  payoutsEnabled         Boolean  @default(false)
  bankHolderName         String?
  bankName               String?
  bankAccountNumber      String?
  bankRoutingCode        String?
  bankCountry            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id])
}

enum ReferralPayoutRequestStatus {
  PENDING
  PAID
  REJECTED
  CONVERTED_TO_SUB
}

model ReferralPayoutRequest {
  id                String                      @id @default(uuid())
  shopId            String
  amount            Float
  currency          String
  status            ReferralPayoutRequestStatus @default(PENDING)
  bankHolderName    String?
  bankName          String?
  bankAccountNumber String?
  bankRoutingCode   String?
  bankCountry       String?
  monthsGranted     Float?
  payoutReference   String?
  adminNote         String?
  paidAt            DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([status, createdAt])
  @@index([shopId])
}

// ── Blog Posts ─────────────────────────────────────────────────
model BlogPost {
  id         String  @id @default(uuid())
  slug       String  @unique
  title      String
  excerpt    String? @db.Text // Short summary for listing cards
  content    String  @db.Text // HTML content
  coverImage String? // URL to a cover/hero image

  // SEO fields
  metaTitle       String? // Override <title> tag
  metaDescription String?  @db.Text
  metaKeywords    String[] // Array of keyword strings
  canonicalUrl    String?

  // Categorisation
  category String   @default("General")
  tags     String[] // Freeform tags

  // Authoring
  author     String  @default("Orivraa Team")
  authorRole String?
  readTime   String? // e.g. "8 min read"

  // Publishing
  isPublished Boolean   @default(false)
  featured    Boolean   @default(false)
  publishedAt DateTime?
  sortOrder   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, publishedAt])
  @@index([category])
  @@index([featured])
}

// ── Support Contacts ───────────────────────────────────────────
model SupportContact {
  id          String   @id @default(uuid())
  country     String
  countryFlag String
  type        String // PHONE, WHATSAPP, EMAIL
  value       String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([country, isActive])
}

// ── AI Chat Logs ──────────────────────────────────────────────
// ── Bot Conversation Sessions ─────────────────────────────────
// One record per browser-tab chat session. Groups all AiChatLog
// entries so you can replay full conversations and track leads.
enum LeadStatus {
  NEW
  CONTACTED
  WON
  LOST
}

enum LeadSource {
  GOOGLE_MAPS
  AI_CHATBOT
  MANUAL_IMPORT
  REFERRAL
  WHATSAPP
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageChannel {
  WHATSAPP
  SMS
}

enum MessageSender {
  LEAD
  AI_BOT
  ADMIN
  SYSTEM
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

model Lead {
  id                             String        @id @default(uuid())
  shopName                       String
  contactName                    String?
  email                          String?
  phone                          String?
  website                        String?
  address                        String?
  city                           String?
  state                          String?
  country                        String        @default("NP")
  source                         LeadSource    @default(GOOGLE_MAPS)
  status                         LeadStatus    @default(NEW)
  rating                         Float?
  reviewCount                    Int?
  notes                          String?       @db.Text
  outreachCount                  Int           @default(0)
  lastEmailedAt                  DateTime?
  lastCampaignKey                String?
  whatsappOptOut                 Boolean       @default(false)
  aiBotPaused                    Boolean       @default(false)
  customerServiceWindowExpiresAt DateTime?
  lastMessageAt                  DateTime?
  metadata                       Json?
  botSessionId                   String?
  botSession                     BotSession?   @relation(fields: [botSessionId], references: [id], onDelete: SetNull)
  convertedUserId                String?
  convertedShopId                String?
  messages                       LeadMessage[]
  createdAt                      DateTime      @default(now())
  updatedAt                      DateTime      @updatedAt

  @@index([status])
  @@index([source])
  @@index([country, city])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
  @@index([customerServiceWindowExpiresAt])
}

model LeadMessage {
  id               String           @id @default(uuid())
  leadId           String
  lead             Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction        MessageDirection
  channel          MessageChannel   @default(WHATSAPP)
  sender           MessageSender
  body             String           @db.Text
  mediaUrl         String?
  status           MessageStatus    @default(SENT)
  twilioMessageSid String?
  rawPayload       Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([leadId, createdAt])
  @@index([twilioMessageSid])
  @@map("lead_messages")
}

model BotSession {
  id              String      @id // UUID generated by client (sessionStorage)
  ipAddress       String?
  userAgent       String?
  messageCount    Int         @default(0) // counts user turns only
  escalated       Boolean     @default(false)
  leadIntents     String[]    @default([]) // e.g. ["pricing","trial","comparison"]
  guestName       String? // populated on escalation or lead capture
  guestEmail      String? // populated on escalation or lead capture
  guestPhone      String? // populated when visitor shares phone number
  contactCaptured Boolean     @default(false) // true once any contact info is saved
  awaitingContact Boolean     @default(false) // true after bot asks for email/WhatsApp
  leadStatus      LeadStatus? // set to NEW on first contact capture
  leadNotes       String?     @db.Text
  leadContactedAt DateTime?
  startedAt       DateTime    @default(now())
  lastMessageAt   DateTime    @default(now())
  expiresAt       DateTime // startedAt + 12 months (retention policy)

  logs  AiChatLog[]
  leads Lead[]

  @@index([startedAt])
  @@index([expiresAt])
  @@index([contactCaptured, leadStatus])
  @@index([awaitingContact])
}

model AiChatLog {
  id          String      @id @default(uuid())
  sessionId   String?
  session     BotSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  role        String // user or assistant
  content     String      @db.Text
  actionTaken String?
  confidence  Float?
  ipAddress   String?
  createdAt   DateTime    @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

// ── Web App Sessions ──────────────────────────────────────────
// Tracks every browser session: open time, close time, duration, page views
model WebSession {
  id           String    @id @default(cuid())
  userId       String? // null = unauthenticated visitor
  sessionToken String    @unique // random uuid generated client-side
  role         String? // CUSTOMER | SHOPKEEPER | ADMIN | guest
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  durationSec  Int? // computed when session closes
  pageViews    Int       @default(0)
  lastActive   DateTime  @default(now())
  ipAddress    String?
  country      String?
  userAgent    String?
  platform     String    @default("web")
  referrer     String? // utm / referrer URL
  closedBy     String? // "user_logout" | "timeout" | "beacon" | "pin_lock"

  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  pageViewDetails SessionPageView[]

  @@index([userId])
  @@index([startedAt])
  @@index([role, startedAt])
  @@index([userId, startedAt])
}

/// Per-page visit record — one row per page the user navigated to within a session
model SessionPageView {
  id          String   @id @default(cuid())
  sessionId   String
  path        String // e.g. "/dashboard/shop"
  title       String? // document.title at visit time
  durationSec Int? // seconds spent on this page before navigating away
  visitedAt   DateTime @default(now())

  session WebSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([path])
}

// -----------------------------------------------------------------------------
// SURVEY SYSTEM
// -----------------------------------------------------------------------------

model Survey {
  id          String   @id @default(uuid())
  title       String
  description String?
  isActive    Boolean  @default(false)
  targetRole  String? // e.g., "CUSTOMER", "SHOPKEEPER", or null for everyone
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@index([isActive])
}

model SurveyQuestion {
  id         String  @id @default(uuid())
  surveyId   String
  text       String
  type       String // "RATING", "TEXT", "MULTIPLE_CHOICE"
  options    Json? // Array of string options for multiple choice
  isRequired Boolean @default(true)
  orderIdx   Int     @default(0)

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@index([surveyId])
  @@index([surveyId, orderIdx])
}

model SurveyResponse {
  id          String    @id @default(uuid())
  surveyId    String
  userId      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@unique([surveyId, userId]) // A user can only respond once per survey
  @@index([userId])
}

model SurveyAnswer {
  id         String @id @default(uuid())
  responseId String
  questionId String
  value      String // Stringified answer

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
}

/// Support bot RAG — knowledge chunks embedded with gemini-embedding-001 (3072-dim)
model KnowledgeChunk {
  id        String                       @id @default(uuid())
  topic     String // e.g. "pricing", "gst", "hallmark"
  content   String // Raw text of the chunk
  embedding Unsupported("vector(3072)")?
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@index([topic])
}
