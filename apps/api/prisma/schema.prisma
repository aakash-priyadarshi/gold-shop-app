model JournalEntry {
  id                  String               @id @default(uuid())
  shopId              String
  entryNumber         String               @db.VarChar(64)
  status              JournalEntryStatus   @default(DRAFT)
  referenceType       JournalReferenceType
  referenceId         String
  idempotencyKey      String               @db.VarChar(191)
  description         String
  transactionDate     DateTime
  postedAt            DateTime             @default(now())
  canonicalCurrency   CurrencyCode         @default(NPR)
  transactionCurrency CurrencyCode
  transactionAmount   Decimal              @db.Decimal(24, 4)
  canonicalAmountNpr  Decimal              @db.Decimal(24, 4)
  fxRate              Decimal              @db.Decimal(24, 10)
  fxSource            String
  fxQuotedAt          DateTime
  actorUserId         String?
  metadata            Json?
  reversalOfId        String?              @unique
  createdAt           DateTime             @default(now())

  shop       Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  lines      JournalLine[]
  reversalOf JournalEntry? @relation("JournalEntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy JournalEntry? @relation("JournalEntryReversal")

  @@unique([shopId, entryNumber])
  @@unique([shopId, idempotencyKey])
  @@unique([shopId, referenceType, referenceId])
  @@index([shopId, transactionDate])
  @@index([shopId, referenceType, referenceId])
  @@index([reversalOfId])
}

model JournalLine {
  id                  String       @id @default(uuid())
  journalEntryId      String
  accountId           String
  description         String?
  debitNpr            Decimal      @default(0) @db.Decimal(24, 4)
  creditNpr           Decimal      @default(0) @db.Decimal(24, 4)
  transactionDebit    Decimal      @default(0) @db.Decimal(24, 4)
  transactionCredit   Decimal      @default(0) @db.Decimal(24, 4)
  transactionCurrency CurrencyCode
  createdAt           DateTime     @default(now())

  journalEntry JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account      LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
}

