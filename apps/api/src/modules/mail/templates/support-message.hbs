<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <style>
    body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; background-color: #f5f5f5; color: #333333; line-height: 1.6; }
    .wrapper { width: 100%; background-color: #f5f5f5; padding: 40px 0; }
    .main { max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05); }
    .header { background-color: #111827; padding: 28px 40px; text-align: center; }
    .logo { font-size: 26px; font-weight: bold; color: #ffffff; text-decoration: none; }
    .content { padding: 40px; }
    .footer { background-color: #f9fafb; padding: 30px 40px; text-align: center; border-top: 1px solid #e5e7eb; }
    .footer p { margin: 5px 0; font-size: 13px; color: #6b7280; }
    .footer a { color: #b45309; text-decoration: none; }
    h1 { font-size: 24px; font-weight: 600; color: #111827; margin: 0 0 20px 0; }
    p { margin: 0 0 16px 0; color: #4b5563; }
    .message-box { background-color: #fffbeb; border: 1px solid #f3d27a; border-radius: 8px; padding: 22px; margin: 24px 0; }
    .message-text { white-space: pre-line; color: #374151; font-size: 15px; margin: 0; }
    .small-text { font-size: 13px; color: #6b7280; }
    @media only screen and (max-width: 600px) {
      .content { padding: 30px 20px; }
      .header, .footer { padding-left: 20px; padding-right: 20px; }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="main">
      <div class="header">
        <a href="{{appUrl}}" class="logo">{{appName}}</a>
      </div>
      <div class="content">
        <h1>{{title}}</h1>

        <p>Hi {{recipientName}},</p>

        <div class="message-box">
          <p class="message-text">{{message}}</p>
        </div>

        <p>You can reply to this email or contact us at <a href="mailto:{{supportEmail}}" style="color: #b45309;">{{supportEmail}}</a>.</p>

        <p>Regards,<br><strong>The {{appName}} Team</strong></p>

        <p class="small-text">Sent on {{formatDateTime sentAt}}.</p>
      </div>
      <div class="footer">
        <p>&copy; {{year}} {{appName}}. All rights reserved.</p>
        <p><a href="{{appUrl}}">Visit Website</a> &bull; <a href="mailto:{{supportEmail}}">Contact Support</a></p>
      </div>
    </div>
  </div>
</body>
</html>