{
  "name": "gold-shop-e2e",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "demo:setup": "ts-node auth-setup.ts",
    "demo": "playwright test seller-demo --project=chromium --headed --workers=1",
    "auth:import": "node scripts/import-session.mjs",
    "seller-api": "node scripts/api-core-pipeline.mjs",
    "kane:public": "node kane/run.mjs --suite public",
    "kane:seller": "node kane/run.mjs --suite seller",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
